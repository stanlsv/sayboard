    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard potřebuje přístup k mikrofonu pro převod řeči na text. Veškeré zpracování probíhá na zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard har brug for mikrofonadgang for at omdanne din tale til tekst. Al behandling sker på enheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard verwendet das Mikrofon, um Ihre Sprache in Text umzuwandeln. Die gesamte Verarbeitung erfolgt auf dem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sayboard χρειάζεται πρόσβαση στο μικρόφωνο για να μετατρέπει την ομιλία σας σε κείμενο. Όλη η επεξεργασία γίνεται στη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard needs microphone access to convert your speech to text. All processing happens on-device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard necesita acceso al micrófono para convertir su voz en texto. Todo el procesamiento se realiza en el dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard tarvitsee mikrofonin käyttöoikeuden, jotta puheesi voidaan muuntaa tekstiksi. Kaikki käsittely tapahtuu laitteessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard utilise le microphone pour convertir votre voix en texte. Tout le traitement se fait sur l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard को आपकी आवाज़ को टेक्स्ट में बदलने के लिए माइक्रोफ़ोन एक्सेस की ज़रूरत है। सारी प्रोसेसिंग डिवाइस पर होती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sayboard-nak mikrofon-hozzáférésre van szüksége a beszéd szöveggé alakításához. Minden feldolgozás az eszközön történik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard usa il microfono per convertire la Sua voce in testo. Tutta l’elaborazione avviene sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboardは音声をテキストに変換するためにマイクへのアクセスが必要です。すべての処理はデバイス上で行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard는 음성을 텍스트로 변환하기 위해 마이크 접근 권한이 필요합니다. 모든 처리는 기기에서 이루어집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard heeft microfoontoegang nodig om uw spraak naar tekst om te zetten. Alle verwerking gebeurt op het apparaat."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard trenger mikrofontilgang for å gjøre tale om til tekst. All behandling skjer på enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard używa mikrofonu do zamiany mowy na tekst. Całe przetwarzanie odbywa się na urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sayboard precisa de acesso ao microfone para converter sua fala em texto. Todo o processamento acontece no dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard are nevoie de acces la microfon pentru a converti vocea dvs. în text. Toată procesarea are loc pe dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard нужен доступ к микрофону для преобразования речи в текст. Вся обработка происходит на устройстве."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard potrebuje prístup k mikrofónu na prevod reči na text. Všetko spracovanie prebieha na zariadení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard behöver mikrofonåtkomst för att omvandla ditt tal till text. All bearbetning sker på enheten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard, konuşmanızı metne dönüştürmek için mikrofon erişimine ihtiyaç duyar. Tüm işlem cihazda gerçekleşir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard потребує доступу до мікрофона для перетворення мовлення на текст. Уся обробка відбувається на пристрої."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard 需要麦克风权限来将您的语音转换为文字。所有处理均在设备上完成。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard се нуждае от достъп до микрофона, за да преобразува речта Ви в текст. Цялата обработка се извършва на устройството."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboardu je potreban pristup mikrofonu za pretvaranje govora u tekst. Cijela obrada odvija se na uređaju."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard vajab juurdepääsu mikrofonile, et muuta teie kõne tekstiks. Kogu töötlus toimub seadmes."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard nepieciešama piekļuve mikrofonam, lai pārveidotu runu tekstā. Visa apstrāde notiek ierīcē."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard naudoja mikrofoną kalbai paversti tekstu. Visas apdorojimas vyksta įrenginyje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard potrebuje dostop do mikrofona za pretvorbo govora v besedilo. Vsa obdelava poteka v napravi."
          }
        }
      }
    }
  },
  "version": "1.0"
}
