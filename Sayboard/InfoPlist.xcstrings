    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard potřebuje přístup k mikrofonu pro převod řeči na text. Veškeré zpracování probíhá na zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard har brug for mikrofonadgang for at omdanne din tale til tekst. Al behandling sker på enheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard verwendet das Mikrofon, um Ihre Sprache in Text umzuwandeln. Die gesamte Verarbeitung erfolgt auf dem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sayboard χρειάζεται πρόσβαση στο μικρόφωνο για να μετατρέπει την ομιλία σας σε κείμενο. Όλη η επεξεργασία γίνεται στη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard needs microphone access to convert your speech to text. All processing happens on-device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard necesita acceso al micrófono para convertir su voz en texto. Todo el procesamiento se realiza en el dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard tarvitsee mikrofonin käyttöoikeuden, jotta puheesi voidaan muuntaa tekstiksi. Kaikki käsittely tapahtuu laitteessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard utilise le microphone pour convertir votre voix en texte. Tout le traitement se fait sur l'appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard को आपकी आवाज़ को टेक्स्ट में बदलने के लिए माइक्रोफ़ोन एक्सेस की ज़रूरत है। सारी प्रोसेसिंग डिवाइस पर होती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sayboard-nak mikrofon-hozzáférésre van szüksége a beszéd szöveggé alakításához. Minden feldolgozás az eszközön történik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard usa il microfono per convertire la Sua voce in testo. Tutta l'elaborazione avviene sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboardは音声をテキストに変換するためにマイクへのアクセスが必要です。すべての処理はデバイス上で行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard는 음성을 텍스트로 변환하기 위해 마이크 접근 권한이 필요합니다. 모든 처리는 기기에서 이루어집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard heeft microfoontoegang nodig om uw spraak naar tekst om te zetten. Alle verwerking gebeurt op het apparaat."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard trenger mikrofontilgang for å gjøre tale om til tekst. All behandling skjer på enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard używa mikrofonu do zamiany mowy na tekst. Całe przetwarzanie odbywa się na urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sayboard precisa de acesso ao microfone para converter sua fala em texto. Todo o processamento acontece no dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard are nevoie de acces la microfon pentru a converti vocea dvs. în text. Toată procesarea are loc pe dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard нужен доступ к микрофону для преобразования речи в текст. Вся обработка происходит на устройстве."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard potrebuje prístup k mikrofónu na prevod reči na text. Všetko spracovanie prebieha na zariadení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard behöver mikrofonåtkomst för att omvandla ditt tal till text. All bearbetning sker på enheten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard, konuşmanızı metne dönüştürmek için mikrofon erişimine ihtiyaç duyar. Tüm işlem cihazda gerçekleşir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard потребує доступу до мікрофона для перетворення мовлення на текст. Уся обробка відбувається на пристрої."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard 需要麦克风权限来将您的语音转换为文字。所有处理均在设备上完成。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard се нуждае от достъп до микрофона, за да преобразува речта Ви в текст. Цялата обработка се извършва на устройството."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboardu je potreban pristup mikrofonu za pretvaranje govora u tekst. Cijela obrada odvija se na uređaju."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard vajab juurdepääsu mikrofonile, et muuta teie kõne tekstiks. Kogu töötlus toimub seadmes."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard nepieciešama piekļuve mikrofonam, lai pārveidotu runu tekstā. Visa apstrāde notiek ierīcē."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard naudoja mikrofoną kalbai paversti tekstu. Visas apdorojimas vyksta įrenginyje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard potrebuje dostop do mikrofona za pretvorbo govora v besedilo. Vsa obdelava poteka v napravi."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard používá rozpoznávání řeči pro přepis vašeho hlasu. Veškeré zpracování probíhá na zařízení — váš zvuk nikdy neopustí vaše zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard bruger talegenkendelse til at transskribere din stemme. Al behandling sker på enheden — din lyd forlader aldrig din enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard verwendet die Spracherkennung, um Ihre Stimme zu transkribieren. Die gesamte Verarbeitung erfolgt auf dem Gerät — Ihre Audiodaten verlassen niemals Ihr Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sayboard χρησιμοποιεί αναγνώριση ομιλίας για τη μεταγραφή της φωνής σας. Όλη η επεξεργασία γίνεται στη συσκευή — ο ήχος σας δεν φεύγει ποτέ από αυτή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard uses speech recognition to transcribe your voice. All processing happens on-device — your audio never leaves your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard usa el reconocimiento de voz para transcribir su voz. Todo el procesamiento se realiza en el dispositivo — su audio nunca sale de su dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard käyttää puheentunnistusta puheesi litterointiin. Kaikki käsittely tapahtuu laitteessa — äänesi ei koskaan poistu laitteestasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard utilise la reconnaissance vocale pour transcrire votre voix. Tout le traitement se fait sur l'appareil — votre audio ne quitte jamais votre appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard आपकी आवाज़ को ट्रांसक्राइब करने के लिए स्पीच रिकग्निशन का उपयोग करता है। सारी प्रोसेसिंग डिवाइस पर होती है — आपका ऑडियो कभी भी आपके डिवाइस से बाहर नहीं जाता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sayboard beszédfelismerést használ a hang átírásához. Minden feldolgozás az eszközön történik — a hangfelvétel soha nem hagyja el az eszközét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard usa il riconoscimento vocale per trascrivere la Sua voce. Tutta l'elaborazione avviene sul dispositivo: il Suo audio non lascia mai il dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboardは音声認識を使用して音声を文字起こしします。すべての処理はデバイス上で行われます。音声データがデバイスの外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard는 음성 인식을 사용하여 음성을 텍스트로 변환합니다. 모든 처리는 기기에서 이루어지며, 오디오는 기기 밖으로 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard gebruikt spraakherkenning om uw stem te transcriberen. Alle verwerking gebeurt op het apparaat — uw audio verlaat nooit uw apparaat."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard bruker talegjenkjenning for å transkribere stemmen din. All behandling skjer på enheten — lyden din forlater aldri enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard używa rozpoznawania mowy do transkrypcji głosu. Całe przetwarzanie odbywa się na urządzeniu — dźwięk nigdy nie opuszcza urządzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sayboard usa reconhecimento de fala para transcrever sua voz. Todo o processamento acontece no dispositivo — seu áudio nunca sai do dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard folosește recunoașterea vocală pentru a transcrie vocea dvs. Toată procesarea are loc pe dispozitiv — audio-ul dvs. nu părăsește niciodată dispozitivul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard использует распознавание речи для расшифровки голоса. Вся обработка происходит на устройстве — аудио никогда не покидает ваше устройство."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard používa rozpoznávanie reči na prepis vášho hlasu. Všetko spracovanie prebieha na zariadení — váš zvuk nikdy neopustí vaše zariadenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard använder taligenkänning för att transkribera din röst. All bearbetning sker på enheten — ditt ljud lämnar aldrig din enhet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard, sesinizi metne dönüştürmek için konuşma tanıma kullanır. Tüm işlem cihazda gerçekleşir — ses kaydınız cihazınızdan asla çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard використовує розпізнавання мовлення для розшифровки вашого голосу. Уся обробка відбувається на пристрої — ваше аудіо ніколи не залишає пристрій."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard 使用语音识别来转录您的语音。所有处理均在设备上完成——您的音频永远不会离开您的设备。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard използва разпознаване на реч за транскрипция на гласа Ви. Цялата обработка се извършва на устройството — аудиото никога не го напуска."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard koristi prepoznavanje govora za transkripciju vašeg glasa. Cijela obrada odvija se na uređaju — vaš zvuk nikad ne napušta vaš uređaj."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard kasutab kõnetuvastust teie hääle transkribeerimiseks. Kogu töötlus toimub seadmes — teie heli ei lahku kunagi teie seadmest."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard izmanto runas atpazīšanu, lai transkribētu Jūsu balsi. Visa apstrāde notiek ierīcē — Jūsu audio nekad nepamet Jūsu ierīci."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard naudoja kalbos atpažinimą balsui transkribuoti. Visas apdorojimas vyksta įrenginyje — garsas niekada nepalieka įrenginio."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard uporablja prepoznavanje govora za transkripcijo Vašega glasu. Vsa obdelava poteka v napravi — Vaš zvok nikoli ne zapusti naprave."
          }
        }
      }
    }
  },
  "version": "1.0"
}
