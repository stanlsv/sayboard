        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "зачекай ти це бачив? він не може повірити що це сталось"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "等等你看到了吗 他不敢相信这事居然发生了"
