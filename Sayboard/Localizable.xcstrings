    "Swipe right to return": {
      "comment": "Title of the host-return overlay shown after a keyboard-triggered dictation on iOS 26.4+. Direction matches the home-indicator swipe-right gesture.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejeďte vpravo pro návrat"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stryg til højre for at vende tilbage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach rechts wischen, um zurückzukehren"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε δεξιά για επιστροφή"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslice a la derecha para volver"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäise oikealle palataksesi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez vers la droite pour revenir"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वापस जाने के लिए दाईं ओर स्वाइप करें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A visszatéréshez lapozzon jobbra"
