    "All recordings from the History tab, including transcription text and audio files stored on this device, will be permanently deleted." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всички записи от раздела „История“, включително текстът на транскрипциите и аудиофайловете на това устройство, ще бъдат изтрити безвъзвратно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny nahrávky ze záložky Historie, včetně textu přepisů a zvukových souborů uložených na tomto zařízení, budou trvale smazány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle optagelser fra fanen Historik, inkl. transskriptionstekst og lydfiler gemt på denne enhed, slettes permanent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Aufnahmen aus dem Verlauf, einschließlich Transkriptionstexte und auf diesem Gerät gespeicherte Audiodateien, werden dauerhaft gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι εγγραφές από την καρτέλα Ιστορικό, συμπεριλαμβανομένου του κειμένου μεταγραφής και των αρχείων ήχου που αποθηκεύονται σε αυτή τη συσκευή, θα διαγραφούν οριστικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las grabaciones de la pestaña Historial, incluido el texto de las transcripciones y los archivos de audio guardados en este dispositivo, se eliminarán de forma permanente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik salvestised vahekaardilt Ajalugu, kaasa arvatud transkriptsioonid ja sellesse seadmesse salvestatud helifailid, kustutatakse jäädavalt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki Historia-välilehden tallennukset, mukaan lukien litteroinnit ja tähän laitteeseen tallennetut äänitiedostot, poistetaan pysyvästi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les enregistrements de l’onglet Historique, y compris les textes de transcription et les fichiers audio stockés sur cet appareil, seront supprimés définitivement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इतिहास टैब की सभी रिकॉर्डिंग, जिसमें इस डिवाइस पर संग्रहीत ट्रांसक्रिप्शन टेक्स्ट और ऑडियो फ़ाइलें शामिल हैं, स्थायी रूप से हटा दी जाएँगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve snimke iz kartice Povijest, uključujući tekst transkripcija i audiodatoteke pohranjene na ovom uređaju, bit će trajno izbrisane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Előzmények lap összes felvétele, beleértve az ezen az eszközön tárolt átiratokat és hangfájlokat, véglegesen törlődik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le registrazioni nella scheda Cronologia, inclusi i testi delle trascrizioni e i file audio archiviati su questo dispositivo, verranno eliminati definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴タブのすべての録音（このデバイスに保存された文字起こしテキストとオーディオファイルを含む）が完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록 탭의 모든 녹음(이 기기에 저장된 변환된 텍스트와 오디오 파일 포함)이 영구적으로 삭제됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visi įrašai iš istorijos kortelės, įskaitant transkripcijos tekstą ir šiame įrenginyje saugomus garso failus, bus visam laikui ištrinti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visi ieraksti no cilnes Vēsture, tostarp transkripcijas teksts un šajā ierīcē saglabātie audio faili, tiks neatgriezeniski dzēsti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle opptak fra Historikk-fanen, inkludert transkripsjonstekst og lydfiler lagret på denne enheten, slettes permanent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle opnames van het tabblad Geschiedenis, inclusief transcriptietekst en audiobestanden opgeslagen op dit apparaat, worden permanent verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie nagrania z karty Historia, w tym tekst transkrypcji i pliki audio przechowywane na tym urządzeniu, zostaną trwale usunięte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as gravações da aba Histórico, incluindo o texto da transcrição e os arquivos de áudio armazenados neste dispositivo, serão excluídos permanentemente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate înregistrările din fila Istoric, inclusiv textul transcrierii și fișierele audio stocate pe acest dispozitiv, vor fi șterse definitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все записи из раздела «История», включая текст расшифровок и аудиофайлы на этом устройстве, будут удалены безвозвратно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky nahrávky zo záložky História, vrátane textu prepisov a zvukových súborov uložených na tomto zariadení, budú natrvalo odstránené."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsi posnetki z zavihka Zgodovina, vključno z besedilom transkripcij in zvočnimi datotekami, shranjenimi v tej napravi, bodo trajno izbrisani."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla inspelningar från fliken Historik, inklusive transkriptionstext och ljudfiler lagrade på den här enheten, raderas permanent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş sekmesindeki tüm kayıtlar, bu cihazda saklanan transkripsiyon metinleri ve ses dosyaları dahil, kalıcı olarak silinecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі записи з вкладки «Історія», включно з текстом розшифровок та аудіофайлами, збереженими на цьому пристрої, буде остаточно видалено."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "历史记录中的所有录音，包括存储在此设备上的转录文本和音频文件，将被永久删除。"
          }
        }
      }
    },
