            "state": "translated",
            "value": "Mali engleski model. Bolji od Moonshine Tiny, bez streaminga."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väike inglise keele mudel. Parem kui Moonshine Tiny, voogedastust pole."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mazs angļu valodas modelis. Labāks par Moonshine Tiny, bez straumēšanas."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
