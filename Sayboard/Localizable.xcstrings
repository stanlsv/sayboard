    "Tap the microphone and start talking. Tap it again when you’re done." : {
      "comment" : "Onboarding",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натиснете микрофона и започнете да говорите. Натиснете го отново, когато приключите."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na mikrofon a začněte mluvit. Až skončíte, klepněte na něj znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på mikrofonen, og begynd at tale. Tryk på den igen, når du er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie auf die Mikrofontaste und sprechen Sie los. Tippen Sie erneut darauf, wenn Sie fertig sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε το μικρόφωνο και αρχίστε να μιλάτε. Πατήστε το ξανά όταν τελειώσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque el micrófono y empiece a hablar. Vuelva a tocarlo cuando termine."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puudutage mikrofoni ja hakake rääkima. Kui olete lõpetanud, puudutage seda uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta mikrofonia ja ala puhua. Napauta sitä uudelleen, kun olet valmis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le microphone et commencez à parler. Touchez-le à nouveau quand vous avez terminé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माइक्रोफ़ोन पर टैप करें और बोलना शुरू करें। बात पूरी होने पर उस पर फिर से टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite mikrofon i počnite govoriti. Kad završite, ponovno ga dodirnite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppintson a mikrofonra, és kezdjen el beszélni. Ha végzett, koppintson rá újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocchi il microfono e inizi a parlare. Quando ha finito, lo tocchi di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクをタップして話し始めてください。話し終えたら、もう一度タップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크를 탭한 다음 말하세요. 다 말했으면 다시 탭하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palieskite mikrofoną ir pradėkite kalbėti. Baigę palieskite jį dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieskarieties mikrofonam un sāciet runāt. Kad pabeigsiet, pieskarieties tam vēlreiz."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på mikrofonen og begynn å snakke. Trykk på den igjen når du er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de microfoon en begin te praten. Tik er opnieuw op als u klaar bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij w mikrofon i zacznij mówić. Stuknij ponownie, gdy skończysz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no microfone e comece a falar. Toque nele novamente quando terminar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingeți microfonul și începeți să vorbiți. Atingeți-l din nou când ați terminat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на микрофон и говорите. Чтобы закончить, нажмите на него ещё раз."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ťuknite na mikrofón a začnite hovoriť. Keď skončíte, ťuknite naň znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotaknite se mikrofona in začnite govoriti. Ko končate, se ga znova dotaknite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på mikrofonen och börja prata. Tryck på den igen när du är klar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofona dokunun ve konuşmaya başlayın. Bitirdiğinizde tekrar dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть мікрофон і почніть говорити. Коли закінчите, натисніть його ще раз."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击麦克风，然后开始说话。说完后再点击一次。"
          }
        }
      }
    },
