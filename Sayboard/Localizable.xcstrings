    "I can’t come tomorrow — I’m sick." : {
      "comment" : "History card offering the AI button: the same text after Rewrite",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не мога да дойда утре — разболях се."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zítra nemůžu přijít – není mi dobře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg kan ikke komme i morgen – jeg er syg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kann morgen nicht kommen – ich bin krank."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν μπορώ να έρθω αύριο — αρρώστησα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mañana no puedo ir: me siento mal."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma ei saa homme tulla — olen haige."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pääse huomenna – olen kipeä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne pourrai pas venir demain : je suis malade."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कल मेरा आना नहीं हो पाएगा — मेरी तबीयत ठीक नहीं है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sutra ne mogu doći — nisam dobro."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holnap nem tudok jönni – beteg vagyok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domani non posso venire — non sto bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体調が悪いので、明日は行けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몸이 아파서 내일은 못 갈 것 같아요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rytoj negalėsiu ateiti — sergu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rīt nevarēšu atnākt — saslimu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg kan ikke komme i morgen – jeg er syk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik kan morgen niet komen — ik ben ziek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie mogę jutro przyjść — choruję."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não posso ir amanhã — estou doente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu pot veni mâine — mi-e rău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завтра не смогу прийти — я болею."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zajtra nemôžem prísť – nie je mi dobre."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jutri ne morem priti – bolan sem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag kan inte komma i morgon – jag är sjuk."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yarın gelemeyeceğim, hastayım."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завтра не зможу прийти — я хворію."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我明天来不了——我生病了。"
          }
        }
      }
    },
    "In Settings, open Keyboards and turn on both switches. Full Access goes last." : {
      "comment" : "Onboarding",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Настройки отворете „Клавиатури“ и включете двата превключвателя. Пълния достъп включете накрая."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V Nastavení klepněte na Klávesnice a zapněte oba přepínače. Plný přístup povolte až nakonec."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn Tastaturer i Indstillinger, og slå begge kontakter til. Slå fuld adgang til som det sidste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie in den Einstellungen „Tastaturen“ und aktivieren Sie beide Schalter. Den vollen Zugriff erlauben Sie zuletzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στις Ρυθμίσεις, ανοίξτε τα Πληκτρολόγια και ενεργοποιήστε και τους δύο διακόπτες. Την πλήρη πρόσβαση αφήστε την για το τέλος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Ajustes, abra Teclados y active las dos opciones. Deje el acceso completo para el final."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avage Seadetes jaotis Klaviatuurid ja lülitage mõlemad lülitid sisse. Jätke täielik juurdepääs viimaseks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa Asetuksissa kohta Näppäimistöt ja laita molemmat kytkimet päälle. Salli täysi käyttöoikeus viimeisenä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Réglages, ouvrez « Claviers » et activez les deux options, en terminant par l’accès complet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग में “कीबोर्ड” खोलें और दोनों स्विच चालू करें। पूर्ण एक्सेस सबसे आख़िर में चालू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U Postavkama otvorite Tipkovnice i uključite oba prekidača. Potpuni pristup uključite na kraju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Beállításokban nyissa meg a Billentyűzetek menüt, és kapcsolja be mindkét kapcsolót. A Teljes hozzáférést hagyja utoljára."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Impostazioni, apra Tastiere e attivi entrambi gli interruttori. L’accesso completo va attivato per ultimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“設定”で“キーボード”を開き、両方のスイッチをオンにしてください。フルアクセスは最後にオンにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 ‘키보드’를 열고 스위치 두 개를 모두 켜되, ‘전체 접근 허용’은 마지막에 켜세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nustatymuose atidarykite „Klaviatūros“ ir įjunkite abu jungiklius. Visapusišką prieigą įjunkite paskutinę."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iestatījumos atveriet sadaļu Tastatūras un ieslēdziet abus slēdžus. Pilnu piekļuvi ieslēdziet kā pēdējo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Innstillinger åpner du Tastaturer og slår på begge bryterne. Full tilgang slår du på sist."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Toetsenborden in Instellingen en zet beide schakelaars aan. Volledige toegang komt als laatste."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Ustawieniach otwórz Klawiatury i włącz oba przełączniki. Pełny dostęp włącz na końcu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em Ajustes, toque em Teclados e ative as duas opções. Deixe o acesso completo por último."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În Configurări, deschideți Tastaturi și activați ambele opțiuni. Accesul complet se activează la final."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Настройках откройте «Клавиатуры» и включите оба переключателя. Полный доступ — последним."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
