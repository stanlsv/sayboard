          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard mora biti dodan kao tipkovnica kako biste mogli koristiti glasovno diktiranje u bilo kojoj aplikaciji."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
