    "Sayboard needs to be added as a keyboard to use voice dictation in any app.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard нужно добавить как клавиатуру, чтобы использовать голосовой ввод в любом приложении."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
