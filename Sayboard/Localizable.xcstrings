    "Could not reach model server. Check your connection and try again." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сървърът на моделите е недостъпен. Проверете връзката си и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze se připojit k serveru modelů. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke nå modelserveren. Kontrollér din forbindelse og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellserver nicht erreichbar. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η σύνδεση με τον διακομιστή μοντέλων. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar al servidor de modelos. Compruebe su conexión y vuelva a intentarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudeli serveriga ei õnnestunud ühendust luua. Kontrollige ühendust ja proovige uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mallipalvelimeen ei saatu yhteyttä. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le serveur de modèles. Vérifiez votre connexion et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मॉडल सर्वर तक नहीं पहुँच सका। अपना कनेक्शन जाँचें और पुनः प्रयास करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelj modela nije dostupan. Provjerite vezu i pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A modellszerver nem érhető el. Ellenőrizze a kapcsolatát, és próbálja újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere il server dei modelli. Controlli la connessione e riprovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルサーバーに接続できません。接続を確認してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델 서버에 연결할 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko pasiekti modelių serverio. Patikrinkite ryšį ir bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās sasniegt modeļu serveri. Pārbaudiet savienojumu un mēģiniet vēlreiz."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke nå modellserveren. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelserver niet bereikbaar. Controleer uw verbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można połączyć się z serwerem modeli. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o servidor de modelos. Verifique sua conexão e tente novamente."
          }
