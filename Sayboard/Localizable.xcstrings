    "Lightest multilingual model. Basic accuracy, but supports 100 languages.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самая лёгкая мультиязычная модель. Базовая точность, но поддержка 100 языков."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejlehčí vícejazyčný model. Základní přesnost, ale podporuje 100 jazyků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Letteste flersprogede model. Grundlæggende nøjagtighed, men understøtter 100 sprog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leichtestes mehrsprachiges Modell. Grundlegende Genauigkeit, aber unterstützt 100 Sprachen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ελαφρύτερο πολυγλωσσικό μοντέλο. Βασική ακρίβεια, αλλά υποστηρίζει 100 γλώσσες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo multilingüe más ligero. Precisión básica, pero admite 100 idiomas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kevyin monikielinen malli. Perustarkkuus, mutta tukee 100 kieltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle multilingue le plus léger. Précision basique, mais prend en charge 100 langues."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे हल्का बहुभाषी मॉडल। बुनियादी सटीकता, लेकिन 100 भाषाओं का समर्थन।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legkönnyebb többnyelvű modell. Alapszintű pontosság, de 100 nyelvet támogat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modello multilingue più leggero. Precisione di base, ma supporta 100 lingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も軽量な多言語モデル。基本的な精度だが、100言語対応。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 가벼운 다국어 모델. 기본 정확도이지만 100개 언어를 지원."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichtste meertalige model. Basisnauwkeurigheid, maar ondersteunt 100 talen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Letteste flerspråklige modell. Grunnleggende nøyaktighet, men støtter 100 språk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najlżejszy model wielojęzyczny. Podstawowa dokładność, ale obsługuje 100 języków."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo multilíngue mais leve. Precisão básica, mas é compatível com 100 idiomas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mai ușor model multilingv. Precizie de bază, dar acceptă 100 de limbi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najľahší viacjazyčný model. Základná presnosť, ale podporuje 100 jazykov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lättaste flerspråkiga modellen. Grundläggande noggrannhet, men stöder 100 språk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En hafif çok dilli model. Temel doğruluk, ancak 100 dili destekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найлегша багатомовна модель. Базова точність, але підтримує 100 мов."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "最轻量的多语言模型。基础精度，但支持 100 种语言。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Най-лекият многоезичен модел. Базова точност, но поддържа 100 езика."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najlakši višejezični model. Osnovna preciznost, ali podržava 100 jezika."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõige kergem mitmekeelne mudel. Algtaseme täpsus, kuid toetab 100 keelt."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vieglākais daudzvalodu modelis. Pamata precizitāte, bet atbalsta 100 valodas."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengviausias daugiakalbis modelis. Bazinis tikslumas, bet palaiko 100 kalbų."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najlažji večjezični model. Osnovna natančnost, vendar podpira 100 jezikov."
          }
        }
      }
