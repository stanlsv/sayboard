    "Not enough storage space. Free up space and try again.": {
      "comment": "Error when model download fails because device storage is full",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно места. Освободите память и попробуйте снова."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedostatek místa v úložišti. Uvolněte místo a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nok lagerplads. Frigør plads og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genügend Speicherplatz. Geben Sie Speicher frei und versuchen Sie es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει αρκετός αποθηκευτικός χώρος. Ελευθερώστε χώρο και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio de almacenamiento suficiente. Libere espacio y vuelva a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennustila ei riitä. Vapauta tilaa ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace de stockage insuffisant. Libérez de l’espace et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्याप्त स्टोरेज नहीं है। जगह खाली करें और पुनः प्रयास करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs elég tárhely. Szabadítson fel helyet, és próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio di archiviazione insufficiente. Liberi spazio e riprovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージ空間が不足しています。空きを作ってもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간이 부족합니다. 공간을 확보하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onvoldoende opslagruimte. Maak ruimte vrij en probeer het opnieuw."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nok lagringsplass. Frigjør plass og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało miejsca. Zwolnij miejsce i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço de armazenamento insuficiente. Libere espaço e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spațiu de stocare insuficient. Eliberați spațiu și încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedostatok miesta v úložisku. Uvoľnite miesto a skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte tillräckligt med lagringsutrymme. Frigör utrymme och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli depolama alanı yok. Yer açıp tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостатньо місця. Звільніть місце та спробуйте знову."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "存储空间不足。请释放空间后重试。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма достатъчно място. Освободете памет и опитайте отново."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema dovoljno prostora za pohranu. Oslobodite prostor i pokušajte ponovno."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mäluruumi ei jätku. Vabastage ruumi ja proovige uuesti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepietiek vietas krātuvē. Atbrīvojiet vietu un mēģiniet vēlreiz."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepakanka vietos atmintyje. Atlaisvinkite vietos ir bandykite dar kartą."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Premalo prostora za shranjevanje. Sprostite prostor in poskusite znova."
          }
        }
      }
    },
    "Now using %@. %@ is still on your device.": {
      "localizations": {
