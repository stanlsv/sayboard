            "value": "Majhen angleški model. Boljši od Moonshine Tiny, brez pretakanja."
          }
        }
      }
    },
    "Smallest and fastest model. Basic quality with multilingual support.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самая маленькая и быстрая модель. Базовое качество с мультиязычной поддержкой."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejmenší a nejrychlejší model. Základní kvalita s vícejazyčnou podporou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindste og hurtigste model. Grundlæggende kvalitet med flersproget understøttelse."
          }
        },
        "de": {
          "stringUnit": {
