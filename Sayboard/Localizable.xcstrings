    "Similar quality to Gemma 3. Stronger in English, weaker multilingual.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Качество как у Gemma 3. Лучше для английского, слабее мультиязычность."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podobná kvalita jako Gemma 3. Silnější v angličtině, slabší vícejazyčně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lignende kvalitet som Gemma 3. Stærkere på engelsk, svagere flersproget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähnliche Qualität wie Gemma 3. Stärker auf Englisch, schwächer mehrsprachig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρόμοια ποιότητα με το Gemma 3. Ισχυρότερο στα αγγλικά, ασθενέστερο πολυγλωσσικά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calidad similar a Gemma 3. Más fuerte en inglés, más débil en multilingüe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Samaa laatua kuin Gemma 3. Vahvempi englannissa, heikompi monikielisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualité similaire à Gemma 3. Plus performant en anglais, plus faible en multilingue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma 3 जैसी गुणवत्ता। अंग्रेज़ी में मजबूत, बहुभाषी में कमज़ोर।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasonló minőség, mint a Gemma 3. Erősebb angolul, gyengébb többnyelvűen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualità simile a Gemma 3. Più forte in inglese, più debole nel multilingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma 3と同等の品質。英語に強く、多言語は弱め。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma 3과 비슷한 품질. 영어에 강하고 다국어에 약함."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijkbare kwaliteit als Gemma 3. Sterker in Engels, zwakker in meertalig."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Lignende kvalitet som Gemma 3. Sterkere på engelsk, svakere flerspråklig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakość podobna do Gemma 3. Lepszy w angielskim, słabszy wielojęzycznie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualidade parecida com a do Gemma 3. Mais forte em inglês, mais fraco em outros idiomas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calitate similară cu Gemma 3. Mai puternic în engleză, mai slab multilingv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podobná kvalita ako Gemma 3. Silnejší v angličtine, slabší viacjazyčne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liknande kvalitet som Gemma 3. Starkare på engelska, svagare flerspråkigt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma 3 ile benzer kalite. İngilizcede daha güçlü, çok dilli kullanımda daha zayıf."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якість подібна до Gemma 3. Сильніша в англійській, слабша багатомовно."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "与 Gemma 3 质量相似。英语更强，多语言较弱。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Качество, сходно с Gemma 3. По-силен на английски, по-слаб многоезично."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slična kvaliteta kao Gemma 3. Jači u engleskom, slabiji u višejezičnosti."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarnane kvaliteet Gemma 3-ga. Tugevam inglise keeles, nõrgem mitmekeelselt."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Līdzīga kvalitāte kā Gemma 3. Stiprāks angļu valodā, vājāks daudzvalodu atbalstā."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Panaši kokybė kaip Gemma 3. Stipresnis anglų kalboje, silpnesnis daugiakalbis."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podobna kakovost kot Gemma 3. Močnejši v angleščini, šibkejši večjezično."
          }
        }
      }
    },
