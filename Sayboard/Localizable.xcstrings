    "Which languages do you dictate in? We’ll pick a speech model for them." : {
      "comment" : "Onboarding",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На кои езици диктувате? Ще подберем подходящ модел за реч."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V jakých jazycích diktujete? Vybereme pro ně model řeči."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilke sprog dikterer du på? Vi vælger en talemodel til dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In welchen Sprachen diktieren Sie? Wir wählen ein passendes Sprachmodell aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε ποιες γλώσσες υπαγορεύετε; Θα επιλέξουμε ένα μοντέλο ομιλίας γι’ αυτές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿En qué idiomas dicta? Elegiremos un modelo de voz adecuado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Millistes keeltes te dikteerite? Valime neile sobiva kõnemudeli."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Millä kielillä sanelet? Valitsemme niille sopivan puhemallin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans quelles langues dictez-vous ? Nous choisirons un modèle vocal adapté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप किन भाषाओं में डिक्टेट करते हैं? हम उनके लिए स्पीच मॉडल चुन देंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na kojim jezicima diktirate? Za njih ćemo odabrati model govora."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milyen nyelveken diktál? Kiválasztjuk hozzájuk a megfelelő beszédmodellt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In quali lingue detta? Sceglieremo un modello vocale adatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの言語で音声入力しますか？その言語に合った音声モデルを選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 언어로 받아쓰기를 하시나요? 알맞은 음성 모델을 골라 드립니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuriomis kalbomis diktuojate? Parinksime joms tinkamą kalbos modelį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurās valodās Jūs diktējat? Mēs izvēlēsimies tām piemērotu runas modeli."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilke språk dikterer du på? Vi velger en talemodell som passer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In welke talen dicteert u? We kiezen er een spraakmodel bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W jakich językach dyktujesz? Dobierzemy do nich model mowy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em quais idiomas você vai ditar? Vamos escolher um modelo de fala para eles."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În ce limbi dictați? Vom alege un model vocal potrivit pentru ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На каких языках вы диктуете? Подберём под них модель речи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V ktorých jazykoch diktujete? Vyberieme pre ne model reči."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V katerih jezikih narekujete? Zanje bomo izbrali model govora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilka språk dikterar du på? Vi väljer en talmodell som passar dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hangi dillerde dikte ediyorsunuz? Bu diller için bir konuşma modeli seçeceğiz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якими мовами ви диктуєте? Ми підберемо для них модель мовлення."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您用哪些语言听写？我们会据此为您选择语音模型。"
          }
        }
      }
    },
    "Without them the keyboard can’t dictate" : {
      "comment" : "Onboarding",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
