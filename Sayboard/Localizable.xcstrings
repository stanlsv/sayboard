    "Best Whisper model. Similar size to Parakeet, but more languages.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучшая модель Whisper. Размер как у Parakeet, но больше языков."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejlepší model Whisper. Podobná velikost jako Parakeet, ale více jazyků."
