    "Smallest and fastest model. Basic quality with multilingual support.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самая маленькая и быстрая модель. Базовое качество с мультиязычной поддержкой."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejmenší a nejrychlejší model. Základní kvalita s vícejazyčnou podporou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindste og hurtigste model. Grundlæggende kvalitet med flersproget understøttelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinstes und schnellstes Modell. Grundlegende Qualität mit mehrsprachiger Unterstützung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μικρότερο και ταχύτερο μοντέλο. Βασική ποιότητα με πολυγλωσσική υποστήριξη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo más pequeño y rápido. Calidad básica con soporte multilingüe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pienin ja nopein malli. Peruslaatu ja monikielinen tuki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle le plus petit et le plus rapide. Qualité basique avec support multilingue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे छोटा और सबसे तेज़ मॉडल। बहुभाषी समर्थन के साथ बुनियादी गुणवत्ता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legkisebb és leggyorsabb modell. Alapszintű minőség többnyelvű támogatással."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modello più piccolo e veloce. Qualità di base con supporto multilingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最小最速のモデル。多言語対応の基本品質。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 작고 빠른 모델. 다국어 지원의 기본 품질."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinste en snelste model. Basiskwaliteit met meertalige ondersteuning."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Minste og raskeste modell. Grunnleggende kvalitet med flerspråklig støtte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najmniejszy i najszybszy model. Podstawowa jakość z obsługą wielu języków."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O menor e mais rápido modelo. Qualidade básica com suporte multilíngue."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mai mic și mai rapid model. Calitate de bază cu suport multilingv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najmenší a najrýchlejší model. Základná kvalita s viacjazyčnou podporou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minsta och snabbaste modellen. Grundläggande kvalitet med flerspråkigt stöd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En küçük ve en hızlı model. Çok dilli destekle temel kalite."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найменша та найшвидша модель. Базова якість із багатомовною підтримкою."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "最小最快的模型。基础质量，支持多语言。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Най-малкият и най-бързият модел. Базово качество с многоезична поддръжка."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najmanji i najbrži model. Osnovna kvaliteta s višejezičnom podrškom."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väikseim ja kiireim mudel. Algtaseme kvaliteet mitmekeelse toega."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mazākais un ātrākais modelis. Pamata kvalitāte ar daudzvalodu atbalstu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mažiausias ir greičiausias modelis. Bazinė kokybė su daugiakalbiu palaikymu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najmanjši in najhitrejši model. Osnovna kakovost z večjezično podporo."
          }
        }
      }
    },
