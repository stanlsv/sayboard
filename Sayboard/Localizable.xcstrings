    "A one-time purchase unlocks unlimited dictation and AI text processing for good and supports Sayboard’s development." : {
      "comment" : "Explanation under the purchase screen title.",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Еднократна покупка отключва завинаги неограничена диктовка и AI обработка на текст и подкрепя развитието на Sayboard."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednorázový nákup natrvalo odemkne neomezené diktování a zpracování textu AI a podpoří vývoj aplikace Sayboard."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et engangskøb låser permanent op for ubegrænset diktering og AI-tekstbehandling og støtter udviklingen af Sayboard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein einmaliger Kauf schaltet unbegrenztes Diktieren und KI-Textverarbeitung dauerhaft frei und unterstützt die Entwicklung von Sayboard."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια εφάπαξ αγορά ξεκλειδώνει μόνιμα απεριόριστη υπαγόρευση και επεξεργασία κειμένου AI και στηρίζει την ανάπτυξη του Sayboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una compra única desbloquea para siempre el dictado ilimitado y el procesamiento de texto con IA, y apoya el desarrollo de Sayboard."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ühekordne ost avab jäädavalt piiramatu dikteerimise ja AI tekstitöötluse ning toetab Sayboardi arendamist."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kertaosto avaa pysyvästi rajattoman sanelun ja AI-tekstinkäsittelyn sekä tukee Sayboardin kehitystä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un achat unique débloque définitivement la dictée illimitée et le traitement de texte IA, et soutient le développement de Sayboard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार की ख़रीदारी से असीमित डिक्टेशन और AI टेक्स्ट प्रोसेसिंग हमेशा के लिए अनलॉक हो जाती है और Sayboard के विकास में मदद मिलती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednokratna kupnja trajno otključava neograničeno diktiranje i AI obradu teksta te podupire razvoj aplikacije Sayboard."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyszeri vásárlással végleg feloldhatja a korlátlan diktálást és az AI szövegfeldolgozást, és támogatja a Sayboard fejlesztését."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un acquisto singolo sblocca per sempre la dettatura illimitata e l’elaborazione testo IA e sostiene lo sviluppo di Sayboard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回の購入で、無制限の音声入力とAIテキスト処理がずっと使えるようになり、Sayboardの開発を支えることにもなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 구입하면 무제한 받아쓰기와 AI 텍스트 처리를 계속 사용할 수 있으며, Sayboard 개발에도 힘이 됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vienkartinis pirkinys visam laikui atrakina neribotą diktavimą ir AI teksto apdorojimą bei padeda kurti Sayboard."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vienreizējs pirkums uz visiem laikiem atbloķē neierobežotu diktēšanu un AI teksta apstrādi un atbalsta Sayboard attīstību."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et engangskjøp låser opp ubegrenset diktering og AI-tekstbehandling for godt og støtter utviklingen av Sayboard."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een eenmalige aankoop ontgrendelt voorgoed onbeperkt dicteren en AI-tekstverwerking en steunt de ontwikkeling van Sayboard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednorazowy zakup na zawsze odblokowuje nieograniczone dyktowanie i przetwarzanie tekstu AI oraz wspiera rozwój Sayboard."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma compra única desbloqueia para sempre o ditado ilimitado e o processamento de texto com IA, e apoia o desenvolvimento do Sayboard."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O achiziție unică deblochează definitiv dictarea nelimitată și procesarea textului cu AI și susține dezvoltarea Sayboard."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разовая покупка навсегда открывает безлимитную диктовку и обработку текста ИИ и поддерживает развитие Sayboard."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednorazový nákup natrvalo odomkne neobmedzené diktovanie a spracovanie textu pomocou AI a podporí vývoj aplikácie Sayboard."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkratni nakup za vedno odklene neomejeno narekovanje in obdelavo besedila z AI ter podpre razvoj aplikacije Sayboard."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
