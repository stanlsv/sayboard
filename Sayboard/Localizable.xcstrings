    "Higher quality than 1B models. English-focused, slower processing.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Качественнее моделей на 1B. Для английского, медленнее обработка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyšší kvalita než modely 1B. Zaměřeno na angličtinu, pomalejší zpracování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højere kvalitet end 1B-modeller. Engelskfokuseret, langsommere behandling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhere Qualität als 1B-Modelle. Auf Englisch fokussiert, langsamere Verarbeitung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υψηλότερη ποιότητα από τα μοντέλα 1B. Εστιασμένο στα αγγλικά, πιο αργή επεξεργασία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayor calidad que los modelos 1B. Centrado en inglés, procesamiento más lento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parempi laatu kuin 1B-malleilla. Painottuu englantiin, hitaampi käsittely."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualité supérieure aux modèles 1B. Axé sur l’anglais, traitement plus lent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1B मॉडल से बेहतर गुणवत्ता। अंग्रेज़ी-केंद्रित, धीमी प्रोसेसिंग।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Magasabb minőség, mint az 1B modellek. Angolra fókuszált, lassabb feldolgozás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualità superiore rispetto ai modelli da 1 miliardo. Focalizzato sull’inglese, elaborazione più lenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1Bモデルより高品質。英語中心、処理速度は遅め。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1B 모델보다 높은 품질. 영어 중심, 처리 속도 느림."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogere kwaliteit dan 1B-modellen. Engelsgericht, langzamere verwerking."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyere kvalitet enn 1B-modeller. Engelskfokusert, tregere behandling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyższa jakość niż modele 1B. Skupiony na angielskim, wolniejsze przetwarzanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualidade superior aos modelos 1B. Focado em inglês, processamento mais lento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calitate mai bună decât modelele 1B. Axat pe engleză, procesare mai lentă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyššia kvalita ako modely 1B. Zameraný na angličtinu, pomalšie spracovanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högre kvalitet än 1B-modeller. Engelskfokuserad, långsammare bearbetning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1B modellerden daha yüksek kalite. İngilizce odaklı, daha yavaş işleme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якісніша за моделі на 1B. Орієнтована на англійську, повільніша обробка."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "比 1B 模型质量更高。以英语为主，处理速度较慢。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "По-високо качество от моделите 1B. Фокус върху английски, по-бавна обработка."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veća kvaliteta od 1B modela. Usmjeren na engleski, sporija obrada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõrgem kvaliteet kui 1B mudelitel. Inglise keelele keskendunud, aeglasem töötlus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Augstāka kvalitāte nekā 1B modeļiem. Vērsts uz angļu valodu, lēnāka apstrāde."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aukštesnė kokybė nei 1B modeliai. Orientuotas į anglų kalbą, lėtesnis apdorojimas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Višja kakovost kot modeli 1B. Osredotočen na angleščino, počasnejša obdelava."
          }
        }
      }
    },
    "Highest quality model. Best multilingual support, but slowest.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучшее качество среди всех моделей. Лучшая мультиязычная поддержка, но самая медленная."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model nejvyšší kvality. Nejlepší vícejazyčná podpora, ale nejpomalejší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Model af højeste kvalitet. Bedste flersprogede understøttelse, men langsomst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell mit höchster Qualität. Beste mehrsprachige Unterstützung, aber am langsamsten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μοντέλο υψηλότερης ποιότητας. Καλύτερη πολυγλωσσική υποστήριξη, αλλά το πιο αργό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de mayor calidad. Mejor soporte multilingüe, pero el más lento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korkein laatu. Paras monikielinen tuki, mutta hitain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle de la plus haute qualité. Meilleur support multilingue, mais le plus lent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वोच्च गुणवत्ता का मॉडल। सबसे अच्छा बहुभाषी समर्थन, लेकिन सबसे धीमा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legmagasabb minőségű modell. Legjobb többnyelvű támogatás, de a leglassabb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modello di qualità più alta. Miglior supporto multilingue, ma il più lento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最高品質のモデル。最高の多言語サポート、ただし最も遅い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최고 품질 모델. 최상의 다국어 지원, 그러나 가장 느림."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model van hoogste kwaliteit. Beste meertalige ondersteuning, maar het langzaamst."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell med høyest kvalitet. Beste flerspråklige støtte, men tregest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model najwyższej jakości. Najlepsza obsługa wielu języków, ale najwolniejszy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo de mais alta qualidade. Melhor suporte multilíngue, mas o mais lento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Model cu cea mai înaltă calitate. Cel mai bun suport multilingv, dar cel mai lent."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Model najvyššej kvality. Najlepšia viacjazyčná podpora, ale najpomalší."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell med högsta kvalitet. Bäst flerspråkigt stöd, men långsammast."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En yüksek kaliteli model. En iyi çok dilli destek, ancak en yavaşı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель найвищої якості. Найкраща багатомовна підтримка, але найповільніша."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "最高质量的模型。最佳多语言支持，但速度最慢。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Модел с най-високо качество. Най-добра многоезична поддръжка, но най-бавен."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model najviše kvalitete. Najbolja višejezična podrška, ali najsporiji."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõrgeima kvaliteediga mudel. Parim mitmekeelne tugi, kuid aeglaseim."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Augstākās kvalitātes modelis. Labākais daudzvalodu atbalsts, bet vislēnākais."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aukščiausios kokybės modelis. Geriausias daugiakalbis palaikymas, bet lėčiausias."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model najvišje kakovosti. Najboljša večjezična podpora, vendar najpočasnejši."
          }
        }
      }
    },
