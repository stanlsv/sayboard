        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα ελευθερώσει αποθηκευτικό χώρο. Μπορείτε να το κατεβάσετε ξανά οποιαδήποτε στιγμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto liberará espacio. Puede volver a descargarlo cuando quiera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä vapauttaa tallennustilaa. Voit ladata sen uudelleen milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela libérera de l’espace de stockage. Vous pourrez le retélécharger à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे स्टोरेज खाली होगा। आप इसे कभी भी फिर से डाउनलोड कर सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel tárhelyet szabadít fel. Bármikor újra letöltheti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione libererà spazio di archiviazione. Potrà riscaricarlo in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージが解放されます。いつでも再ダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간이 확보됩니다. 언제든지 다시 다운로드할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit maakt opslagruimte vrij. U kunt het op elk moment opnieuw downloaden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette frigjør lagringsplass. Du kan laste den ned igjen når som helst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to zwolnienie miejsca. Model można pobrać ponownie w dowolnej chwili."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso liberará espaço de armazenamento. Você pode baixá-lo novamente a qualquer momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest lucru va elibera spațiu de stocare. Îl puteți descărca din nou oricând."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tým sa uvoľní úložisko. Môžete ho kedykoľvek znova stiahnuť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta frigör lagringsutrymme. Du kan ladda ner den igen när som helst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem depolama alanı boşaltır. İstediğiniz zaman tekrar indirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це звільнить сховище. Ви можете завантажити її знову будь-коли."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这将释放存储空间。您可以随时重新下载。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ще освободи място. Можете да го изтеглите отново по всяко време."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Time ćete osloboditi prostor. Možete ga ponovno preuzeti u svakom trenutku."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See vabastab mäluruumi. Saate selle igal ajal uuesti alla laadida."
