          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboardはこれらの言語を優先します。最も正確な認識には1つの言語を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard는 이러한 언어를 우선합니다. 가장 정확한 인식을 위해 단일 언어를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard geeft prioriteit aan deze talen. Kies één taal voor de meest nauwkeurige herkenning."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard prioriterer disse språkene. Velg ett enkelt språk for mest nøyaktig gjenkjenning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard będzie traktować priorytetowo te języki. Wybierz jeden język, aby uzyskać najdokładniejsze rozpoznawanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sayboard priorizará esses idiomas. Escolha um único idioma para o reconhecimento mais preciso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard va prioritiza aceste limbi. Alegeți o singură limbă pentru cea mai precisă recunoaștere."
          }
        },
        "sk": {
          "stringUnit": {
