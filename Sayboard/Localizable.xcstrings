        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa växlingsknapp för tangentbord"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye Geçiş Tuşunu Göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати клавішу перемикання клавіатури"
          }
        },
        "zh": {
          "stringUnit": {
