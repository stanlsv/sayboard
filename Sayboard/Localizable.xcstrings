        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayboard nemato Jūsų įdiegtų programėlių. Paieška vykdoma „App Store“, todėl įsitikinkite, kad pasirinkote tinkamą programėlę."
