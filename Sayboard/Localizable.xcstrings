          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna Tangentbord i Inställningar och slå på båda reglagen. Fullständig åtkomst slår du på sist."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
