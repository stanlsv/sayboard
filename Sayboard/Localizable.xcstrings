    "Display an extra globe key on the keyboard. Your device already provides one, so this is optional.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет дополнительную клавишу глобуса на клавиатуру. Ваше устройство уже предоставляет такую, поэтому это необязательно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí na klávesnici další klávesu s glóbem. Vaše zařízení už jednu poskytuje, takže je to volitelné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis en ekstra globustast på tastaturet. Din enhed har allerede en, så dette er valgfrit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt eine zusätzliche Globustaste auf der Tastatur an. Ihr Gerät stellt bereits eine bereit, daher ist dies optional."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει ένα επιπλέον πλήκτρο υδρογείου στο πληκτρολόγιο. Η συσκευή σας παρέχει ήδη ένα, οπότε αυτό είναι προαιρετικό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una tecla del globo adicional en el teclado. Su dispositivo ya proporciona una, así que es opcional."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä näppäimistössä ylimääräinen maapallonäppäin. Laitteessasi on jo yksi, joten tämä on valinnainen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une touche globe supplémentaire sur le clavier. Votre appareil en fournit déjà une, c’est donc facultatif."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीबोर्ड पर एक अतिरिक्त ग्लोब बटन दिखाता है। आपका डिवाइस पहले से एक प्रदान करता है, इसलिए यह वैकल्पिक है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy plusz földgömb gombot jelenít meg a billentyűzeten. Az eszköz már biztosít egyet, így ez nem kötelező."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un tasto globo aggiuntivo sulla tastiera. Il Suo dispositivo ne fornisce già uno, quindi è facoltativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードに追加の地球儀キーを表示します。お使いのデバイスには既に搭載されているため、これはオプションです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드에 추가 지구본 키를 표시합니다. 기기에서 이미 제공하므로 선택 사항입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont een extra wereldbol-toets op het toetsenbord. Uw apparaat biedt er al een, dus dit is optioneel."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis en ekstra globustast på tastaturet. Enheten din har allerede en, så dette er valgfritt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla dodatkowy klawisz globusa na klawiaturze. Urządzenie już go udostępnia, więc jest to opcjonalne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra uma tecla do globo extra no teclado. Seu dispositivo já fornece uma, então isso é opcional."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează o tastă glob suplimentară pe tastatură. Dispozitivul dvs. oferă deja una, așa că aceasta este opțională."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí na klávesnici ďalší kláves s glóbusom. Vaše zariadenie ho už poskytuje, takže je to voliteľné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa en extra globtangent på tangentbordet. Din enhet har redan en, så detta är valfritt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyede fazladan bir dünya tuşu gösterir. Cihazınız zaten bir tane sağladığından bu isteğe bağlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати додаткову клавішу глобуса на клавіатурі. Ваш пристрій уже надає таку, тож це необовʼязково."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘上额外显示一个地球键。您的设备已经提供了一个，因此这是可选的。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Показва допълнителен бутон с глобус на клавиатурата. Вашето устройство вече предоставя такъв, така че това е по избор."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje dodatnu tipku s globusom na tipkovnici. Vaš uređaj već ima jednu, pa je ovo neobavezno."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva klaviatuuril täiendav gloobuse klahv. Teie seade pakub juba ühte, seega on see valikuline."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parāda tastatūrā papildu globusa taustiņu. Jūsu ierīce jau to nodrošina, tāpēc tas ir izvēles iespēja."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodyti papildomą gaublio klavišą klaviatūroje. Jūsų įrenginys jį jau pateikia, todėl tai pasirinktina."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaže dodatno tipko z globusom na tipkovnici. Vaša naprava jo že ponuja, zato je to izbirno."
          }
        }
      }
    },
