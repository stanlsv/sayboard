    "Enable microphone access so Sayboard can hear you. Your audio never leaves your device.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к микрофону, чтобы Sayboard мог вас слышать. Аудио никогда не покидает ваше устройство."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte přístup k mikrofonu, aby vás Sayboard mohl slyšet. Vaše zvukové nahrávky nikdy neopustí vaše zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver mikrofonadgang, så Sayboard kan høre dig. Din lyd forlader aldrig din enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie den Mikrofonzugriff, damit Sayboard Sie hören kann. Ihre Audiodaten verlassen niemals Ihr Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε την πρόσβαση στο μικρόφωνο ώστε το Sayboard να μπορεί να σας ακούει. Ο ήχος σας δεν φεύγει ποτέ από τη συσκευή σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active el acceso al micrófono para que Sayboard pueda escucharle. Su audio nunca sale de su dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli mikrofonin käyttö, jotta Sayboard voi kuulla sinut. Äänesi ei koskaan poistu laitteestasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’accès au microphone pour que Sayboard puisse vous entendre. Votre audio ne quitte jamais votre appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन एक्सेस सक्षम करें ताकि Sayboard आपको सुन सके। आपका ऑडियो कभी आपके डिवाइस से बाहर नहीं जाता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze a mikrofon-hozzáférést, hogy a Sayboard hallja Önt. A hangfelvétel soha nem hagyja el az eszközét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abiliti l’accesso al microfono in modo che Sayboard possa sentirla. Il Suo audio non lascia mai il dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboardがあなたの声を聞けるようにマイクへのアクセスを有効にしてください。音声データはデバイスから外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard가 들을 수 있도록 마이크 접근을 허용하세요. 오디오는 기기 밖으로 나가지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel microfoontoegang in zodat Sayboard u kan horen. Uw audio verlaat nooit uw apparaat."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver mikrofontilgang slik at Sayboard kan høre deg. Lyden din forlater aldri enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz dostęp do mikrofonu, aby Sayboard mógł słyszeć Twój głos. Dźwięk nigdy nie opuszcza urządzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o acesso ao microfone para que o Sayboard possa ouvir você. Seu áudio nunca sai do seu dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați accesul la microfon pentru ca Sayboard să vă poată auzi. Audio-ul dvs. nu părăsește niciodată dispozitivul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte prístup k mikrofónu, aby vás Sayboard mohol počuť. Váš zvuk nikdy neopustí vaše zariadenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera mikrofonåtkomst så att Sayboard kan höra dig. Ditt ljud lämnar aldrig din enhet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard’un sizi duyabilmesi için mikrofon erişimini etkinleştirin. Ses kaydınız cihazınızdan asla çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть доступ до мікрофона, щоб Sayboard міг вас чути. Ваше аудіо ніколи не залишає пристрій."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "启用麦克风权限，以便 Sayboard 听到您的声音。您的音频永远不会离开您的设备。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешете достъпа до микрофона, за да може Sayboard да Ви чува. Аудиото никога не напуска устройството Ви."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućite pristup mikrofonu kako bi vas Sayboard mogao čuti. Vaš zvuk nikad ne napušta vaš uređaj."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lubage juurdepääs mikrofonile, et Sayboard saaks teid kuulda. Teie heli ei lahku kunagi seadmest."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iespējojiet piekļuvi mikrofonam, lai Sayboard varētu Jūs dzirdēt. Jūsu audio nekad nepamet Jūsu ierīci."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įjunkite prieigą prie mikrofono, kad Sayboard galėtų Jus girdėti. Jūsų garsas niekada nepalieka įrenginio."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogočite dostop do mikrofona, da Vas Sayboard lahko sliši. Vaš zvok nikoli ne zapusti naprave."
          }
        }
      }
    },
