    "Parakeet v3 has been updated and needs to be downloaded again.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet v3 беше обновен и трябва да се изтегли отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
