    "This will free up storage. You can re-download it anytime.": {
      "comment": "Confirmation message when removing a downloaded model",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это освободит место. Вы сможете скачать модель снова в любое время."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se uvolní úložiště. Můžete si jej kdykoli stáhnout znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette frigør lagerplads. Du kan gendownloade den når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
