    "These are the languages you speak, taken from your device and keyboards. The app language stays the same." : {
      "comment" : "Onboarding",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това са езиците, които говорите, взети от устройството и клавиатурите Ви. Езикът на приложението не се променя."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto jsou jazyky, kterými mluvíte, podle nastavení zařízení a klávesnic. Jazyk aplikace se tím nezmění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er de sprog, du taler, ifølge din enhed og dine tastaturer. Appsproget ændres ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sind die Sprachen, die Sie sprechen, übernommen aus Ihren Geräte- und Tastatureinstellungen. Die App-Sprache bleibt unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
