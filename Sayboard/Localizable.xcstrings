        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayboard nie widzi zainstalowanych aplikacji. Wyszukiwanie odbywa się w App Store, więc należy upewnić się, że wybrano właściwą aplikację."
          }
