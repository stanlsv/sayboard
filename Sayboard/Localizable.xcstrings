    "Sayboard can’t see your installed apps. Search is performed in the App Store, so make sure you select the right app.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard не видит ваши установленные приложения. Поиск идёт через App Store, поэтому убедитесь, что выбрали нужное приложение."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard nevidí vaše nainstalované aplikace. Vyhledávání probíhá v App Storu, proto se ujistěte, že vyberete správnou aplikaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard kan ikke se dine installerede apps. Søgning udføres i App Store, så sørg for at vælge den rigtige app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard kann Ihre installierten Apps nicht sehen. Die Suche wird im App Store durchgeführt — wählen Sie also die richtige App aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sayboard δεν μπορεί να δει τις εγκατεστημένες εφαρμογές σας. Η αναζήτηση γίνεται στο App Store, οπότε βεβαιωθείτε ότι επιλέγετε τη σωστή εφαρμογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard no puede ver sus apps instaladas. La búsqueda se realiza en el App Store, así que asegúrese de seleccionar la app correcta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard ei näe asennettuja ohjelmiasi. Haku tehdään App Storessa, joten varmista, että valitset oikean ohjelman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard ne peut pas voir vos applications installées. La recherche est effectuée dans l’App Store — assurez-vous donc de sélectionner la bonne application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard आपके इंस्टॉल किए गए ऐप्स नहीं देख सकता। खोज App Store में की जाती है, इसलिए सुनिश्चित करें कि आप सही ऐप चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sayboard nem látja a telepített alkalmazásait. A keresés az App Store-ban történik, ezért győződjön meg arról, hogy a megfelelő alkalmazást választja ki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard non può vedere le Sue app installate. La ricerca viene effettuata nell’App Store, quindi si assicuri di selezionare l’app corretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboardはインストール済みのアプリを見ることはできません。検索はApp Storeで行われるため、正しいアプリを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard는 설치된 앱을 볼 수 없습니다. 검색은 App Store에서 수행되므로 올바른 앱을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard kan uw geïnstalleerde apps niet zien. De zoekopdracht wordt uitgevoerd in de App Store, dus zorg ervoor dat u de juiste app selecteert."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard kan ikke se de installerte appene dine. Søket utføres i App Store, så pass på at du velger riktig app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard nie widzi zainstalowanych aplikacji. Wyszukiwanie odbywa się w App Store, więc należy upewnić się, że wybrano właściwą aplikację."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sayboard não consegue ver os apps instalados. A busca é feita na App Store, então confira se você selecionou o app certo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard nu poate vedea aplicațiile dvs. instalate. Căutarea se face în App Store, așa că asigurați-vă că selectați aplicația corectă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard nevidí vaše nainštalované aplikácie. Vyhľadávanie sa vykonáva v App Store, preto sa uistite, že vyberiete správnu aplikáciu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard kan inte se dina installerade appar. Sökningen sker i App Store, så se till att du väljer rätt app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard, yüklü uygulamalarınızı göremez. Arama App Store’da yapıldığından doğru uygulamayı seçtiğinizden emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard не бачить ваших встановлених застосунків. Пошук виконується в App Store, тож переконайтеся, що ви обираєте правильний застосунок."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard 无法看到您已安装的应用。搜索通过 App Store 执行，请确保选择正确的应用。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard не вижда инсталираните Ви приложения. Търсенето се извършва в App Store, така че се уверете, че избирате правилното приложение."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard ne vidi vaše instalirane aplikacije. Pretraživanje se obavlja u App Storeu, stoga svakako odaberite pravu aplikaciju."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard ei näe teie paigaldatud rakendusi. Otsing toimub App Store’is, seega veenduge, et valite õige rakenduse."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard neredz Jūsu instalētās lietotnes. Meklēšana notiek App Store, tāpēc pārliecinieties, ka atlasāt pareizo lietotni."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard nemato Jūsų įdiegtų programėlių. Paieška vykdoma „App Store“, todėl įsitikinkite, kad pasirinkote tinkamą programėlę."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard ne vidi Vaših nameščenih aplikacij. Iskanje poteka v trgovini App Store, zato se prepričajte, da izberete pravo aplikacijo."
          }
        }
      }
    },
    "Sayboard needs Full Access to hear your voice from the keyboard.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard нужен полный доступ, чтобы слышать ваш голос с клавиатуры."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard potřebuje plný přístup, aby mohl slyšet váš hlas z klávesnice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard har brug for Fuld adgang for at kunne høre din stemme fra tastaturet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard benötigt Vollzugriff, um Ihre Stimme über die Tastatur zu hören."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sayboard χρειάζεται Πλήρη Πρόσβαση για να ακούει τη φωνή σας από το πληκτρολόγιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard necesita acceso completo para escuchar su voz desde el teclado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard tarvitsee täyden käyttöoikeuden, jotta se voi kuulla äänesi näppäimistöstä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard a besoin de l’accès complet pour entendre votre voix depuis le clavier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीबोर्ड से आपकी आवाज़ सुनने के लिए Sayboard को पूर्ण एक्सेस चाहिए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sayboard-nak Teljes hozzáférésre van szüksége, hogy a billentyűzetről hallja a hangját."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard ha bisogno dell’accesso completo per sentire la Sua voce dalla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードから音声を聞くには、Sayboardにフルアクセスを許可する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드에서 음성을 듣기 위해 Sayboard는 전체 접근 권한이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard heeft Volledige toegang nodig om uw stem vanaf het toetsenbord te horen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard trenger Full tilgang for å høre stemmen din fra tastaturet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard wymaga pełnego dostępu, aby słyszeć głos z klawiatury."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sayboard precisa de acesso completo para ouvir sua voz pelo teclado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard are nevoie de Acces complet pentru a vă auzi vocea de la tastatură."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard potrebuje plný prístup, aby mohol počuť váš hlas z klávesnice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard behöver fullständig åtkomst för att höra din röst från tangentbordet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard’un klavyeden sesinizi duyabilmesi için Tam Erişim gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard потребує повного доступу, щоб чути ваш голос із клавіатури."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard 需要完全访问权限，才能从键盘听到您的声音。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard се нуждае от пълен достъп, за да чува гласа Ви от клавиатурата."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboardu je potreban potpuni pristup kako bi mogao čuti vaš glas s tipkovnice."
          }
        },
        "et": {
