    "Up to %lld custom prompts. These appear in the keyboard's AI action sheet.": {
      "comment": "A footer in the AI text processing settings view that explains the maximum number of custom prompts that can be added.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До %lld пользовательских промптов. Они появятся в меню ИИ на клавиатуре."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až %lld vlastních promptů. Zobrazí se v nabídce akcí AI na klávesnici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op til %lld brugerdefinerede prompts. Disse vises i tastaturets AI-handlingsark."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %lld benutzerdefinierte Prompts. Diese erscheinen im AI-Aktionsmenü der Tastatur."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έως %lld προσαρμοσμένες προτροπές. Εμφανίζονται στο φύλλο ενεργειών AI του πληκτρολογίου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta %lld comandos personalizados. Aparecen en la hoja de acciones de IA del teclado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enintään %lld omaa kehotetta. Ne näkyvät näppäimistön AI-toimintovalikossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à %lld prompts personnalisés. Ils apparaissent dans la feuille d'actions IA du clavier."
