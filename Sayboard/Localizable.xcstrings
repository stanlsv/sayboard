    "Adds an AI button to the keyboard for rewriting, reformatting, and other text actions.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет кнопку ИИ на клавиатуру для перефразирования, форматирования и других действий с текстом."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá na klávesnici tlačítko AI pro přepisování, přeformátování a další textové akce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføjer en AI-knap til tastaturet til omskrivning, omformatering og andre teksthandlinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt der Tastatur eine AI-Taste zum Umschreiben, Umformatieren und für andere Textaktionen hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέτει ένα κουμπί AI στο πληκτρολόγιο για αναδιατύπωση, αναμορφοποίηση και άλλες ενέργειες κειμένου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un botón de IA al teclado para reescribir, reformatear y otras acciones con texto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää näppäimistöön AI-painikkeen tekstin uudelleenkirjoittamista, muotoilua ja muita toimintoja varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un bouton IA au clavier pour la réécriture, le reformatage et d’autres actions textuelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्लेखन, पुनर्स्वरूपण और अन्य टेक्स्ट क्रियाओं के लिए कीबोर्ड में AI बटन जोड़ता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "AI gombot ad a billentyűzethez átíráshoz, újraformázáshoz és egyéb szöveges műveletekhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge un pulsante IA alla tastiera per riscrittura, riformattazione e altre azioni sul testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き換え、再フォーマット、その他のテキスト操作のためのAIボタンをキーボードに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 쓰기, 형식 변경 등 텍스트 작업을 위한 AI 버튼을 키보드에 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt een AI-knop toe aan het toetsenbord voor herschrijven, herformatteren en andere tekstacties."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Legger til en AI-knapp på tastaturet for omskriving, omformatering og andre teksthandlinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje przycisk AI do klawiatury do przepisywania, przeformatowywania i innych operacji na tekście."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um botão de IA ao teclado para reescrever, reformatar e outras ações de texto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un buton AI pe tastatură pentru rescriere, reformatare și alte acțiuni de text."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridá na klávesnicu tlačidlo AI na prepisovanie, preformátovanie a ďalšie textové akcie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger till en AI-knapp på tangentbordet för omskrivning, omformatering och andra textåtgärder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden yazma, yeniden biçimlendirme ve diğer metin işlemleri için klavyeye bir AI düğmesi ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає кнопку ШІ на клавіатуру для переписування, переформатування та інших дій з текстом."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在键盘上添加 AI 按钮，用于改写、重新格式化和其他文本操作。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавя AI бутон на клавиатурата за преписване, преформатиране и други действия с текста."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje AI gumb na tipkovnicu za prepisivanje, preoblikovanje i druge akcije s tekstom."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisab klaviatuurile AI nupu teksti ümberkirjutamiseks, vormindamiseks ja muudeks tegevusteks."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievieno tastatūrai AI pogu pārrakstīšanai, pārformatēšanai un citām teksta darbībām."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prideda AI mygtuką klaviatūroje, skirtą perrašymui, performatavimui ir kitiems teksto veiksmams."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doda gumb AI na tipkovnico za prepisovanje, preoblikovanje in druga besedilna dejanja."
          }
        }
      }
    },
    "After each dictation, the inserted text is also copied to the system clipboard. Replaces the previous clipboard contents.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po každém diktování se vložený text zkopíruje také do systémové schránky. Nahradí předchozí obsah schránky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter hver diktering kopieres den indsatte tekst også til systemets udklipsholder. Erstatter det tidligere indhold i udklipsholderen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jedem Diktat wird der eingefügte Text auch in die Systemzwischenablage kopiert. Ersetzt den vorherigen Inhalt der Zwischenablage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά από κάθε υπαγόρευση, το κείμενο που εισάγεται αντιγράφεται και στο πρόχειρο του συστήματος. Αντικαθιστά τα προηγούμενα περιεχόμενα του πρόχειρου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de cada dictado, el texto insertado también se copia en el portapapeles del sistema. Sustituye el contenido anterior del portapapeles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisen sanelun jälkeen lisätty teksti kopioidaan myös leikepöydälle. Korvaa leikepöydän edellisen sisällön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après chaque dictée, le texte inséré est aussi copié dans le presse-papiers du système. Remplace le contenu précédent du presse-papiers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक डिक्टेशन के बाद, डाला गया टेक्स्ट सिस्टम क्लिपबोर्ड पर भी कॉपी हो जाता है। क्लिपबोर्ड की पिछली सामग्री को बदल देता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden diktálás után a beillesztett szöveg a rendszer vágólapjára is átmásolódik. Felülírja a vágólap korábbi tartalmát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo ogni dettatura, il testo inserito viene copiato anche negli appunti di sistema. Sostituisce il contenuto precedente degli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力のたびに、挿入されたテキストがシステムのクリップボードにもコピーされます。クリップボードの以前の内容は置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기가 끝날 때마다 입력된 텍스트가 시스템 클립보드에도 복사됩니다. 이전 클립보드 내용을 대체합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na elke dictatie wordt de ingevoegde tekst ook naar het systeemklembord gekopieerd. Vervangt de vorige inhoud van het klembord."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter hver diktering kopieres den innsatte teksten også til systemets utklippstavle. Erstatter det forrige innholdet på utklippstavlen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po każdym dyktowaniu wstawiony tekst jest również kopiowany do schowka systemowego. Zastępuje poprzednią zawartość schowka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após cada ditado, o texto inserido também é copiado para a área de transferência do sistema. Substitui o conteúdo anterior da área de transferência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După fiecare dictare, textul introdus este copiat și în clipboardul sistemului. Înlocuiește conținutul anterior al clipboardului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После каждой диктовки вставленный текст также копируется в системный буфер обмена. Заменяет предыдущее содержимое буфера."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po každom diktovaní sa vložený text skopíruje aj do systémovej schránky. Nahradí predchádzajúci obsah schránky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter varje diktering kopieras den infogade texten också till systemets urklipp. Ersätter det tidigare innehållet i urklipp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dikteden sonra eklenen metin sistem panosuna da kopyalanır. Panodaki önceki içeriğin yerini alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після кожного диктування вставлений текст також копіюється в системний буфер обміну. Замінює попередній вміст буфера."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每次听写后，插入的文本也会复制到系统剪贴板。替换剪贴板中的原有内容。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "След всяка диктовка вмъкнатият текст се копира и в системния клипборд. Заменя предишното съдържание на клипборда."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon svakog diktiranja umetnuti tekst kopira se i u sistemski međuspremnik. Zamjenjuje prethodni sadržaj međuspremnika."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pärast iga dikteerimist kopeeritakse lisatud tekst ka süsteemi lõikepuhvrisse. Asendab lõikepuhvri varasema sisu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pēc katras diktēšanas ievietotais teksts tiek nokopēts arī sistēmas starpliktuvē. Aizstāj iepriekšējo starpliktuves saturu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Po kiekvieno diktavimo įterptas tekstas taip pat kopijuojamas į sistemos iškarpinę. Pakeičia ankstesnį iškarpinės turinį."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po vsakem narekovanju se vstavljeno besedilo kopira tudi v sistemsko odložišče. Nadomesti prejšnjo vsebino odložišča."
          }
        }
      }
    },
