    "Compiled models will be removed from cache. Recompilation will be required on next use, which may take up to a minute." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компилираните модели ще бъдат премахнати от кеша. При следващата употреба ще е необходима повторна компилация, което може да отнеме до минута."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkompilované modely budou odstraněny z mezipaměti. Při příštím použití bude nutná opětovná kompilace, která může trvat až minutu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompilerede modeller fjernes fra cachen. Næste gang du bruger dem, skal de kompileres igen, hvilket kan tage op til et minut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompilierte Modelle werden aus dem Cache entfernt. Bei der nächsten Verwendung ist eine Neukompilierung erforderlich, die bis zu einer Minute dauern kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα μεταγλωττισμένα μοντέλα θα αφαιρεθούν από την κρυφή μνήμη. Θα απαιτηθεί εκ νέου μεταγλώττιση κατά την επόμενη χρήση, η οποία μπορεί να διαρκέσει έως ένα λεπτό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos compilados se eliminarán del caché. Habrá que recompilarlos en el próximo uso, lo que puede tardar hasta un minuto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompileeritud mudelid eemaldatakse vahemälust. Järgmisel kasutamisel on vaja need uuesti kompileerida, mis võib võtta kuni minuti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käännetyt mallit poistetaan välimuistista. Seuraavalla käytöllä ne käännetään uudelleen, mikä voi kestää jopa minuutin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles compilés seront supprimés du cache. Une recompilation sera nécessaire à la prochaine utilisation, ce qui peut prendre jusqu’à une minute."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संकलित मॉडल कैश से हटा दिए जाएँगे। अगले उपयोग पर पुनः संकलन आवश्यक होगा, जिसमें एक मिनट तक लग सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompajlirani modeli bit će uklonjeni iz predmemorije. Pri sljedećem korištenju potrebna je ponovna kompilacija, što može potrajati do jedne minute."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
