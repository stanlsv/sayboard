    "This model needs more memory (RAM) than your device has": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этой модели требуется больше оперативной памяти (RAM), чем есть на вашем устройстве"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento model potřebuje více paměti (RAM), než má vaše zařízení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne model kræver mere hukommelse (RAM) end din enhed har"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell benötigt mehr Arbeitsspeicher (RAM) als Ihr Gerät hat"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το μοντέλο χρειάζεται περισσότερη μνήμη (RAM) από αυτή που διαθέτει η συσκευή σας"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo necesita más memoria (RAM) de la que tiene su dispositivo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä malli tarvitsee enemmän muistia (RAM) kuin laitteessasi on"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle nécessite plus de mémoire (RAM) que votre appareil n’en dispose"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मॉडल को आपके डिवाइस की उपलब्ध मेमोरी (RAM) से अधिक की ज़रूरत है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a modell több memóriát (RAM) igényel, mint amennyivel az eszköze rendelkezik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo modello richiede più memoria (RAM) di quella disponibile sul Suo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルはデバイスのメモリ（RAM）より多くのメモリが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델은 기기의 메모리(RAM)보다 더 많은 메모리가 필요합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit model heeft meer geheugen (RAM) nodig dan uw apparaat heeft"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne modellen trenger mer minne (RAM) enn enheten din har"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten model wymaga więcej pamięci (RAM) niż dostępna na urządzeniu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo precisa de mais memória (RAM) do que seu dispositivo possui"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest model are nevoie de mai multă memorie (RAM) decât are dispozitivul dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento model potrebuje viac pamäte (RAM), ako má vaše zariadenie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna modell behöver mer minne (RAM) än din enhet har"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu model, cihazınızda bulunandan daha fazla belleğe (RAM) ihtiyaç duyar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
