    "Lightest multilingual model. Basic accuracy, but supports 100 languages." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Най-лекият многоезичен модел. Базова точност, но поддържа 100 езика."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejlehčí vícejazyčný model. Základní přesnost, ale podporuje 100 jazyků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letteste flersprogede model. Grundlæggende nøjagtighed, men understøtter 100 sprog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leichtestes mehrsprachiges Modell. Grundlegende Genauigkeit, aber unterstützt 100 Sprachen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ελαφρύτερο πολυγλωσσικό μοντέλο. Βασική ακρίβεια, αλλά υποστηρίζει 100 γλώσσες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelo multilingüe más ligero. Precisión básica, pero admite 100 idiomas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõige kergem mitmekeelne mudel. Algtaseme täpsus, kuid toetab 100 keelt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kevyin monikielinen malli. Perustarkkuus, mutta tukee 100 kieltä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modèle multilingue le plus léger. Précision basique, mais prend en charge 100 langues."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे हल्का बहुभाषी मॉडल। बुनियादी सटीकता, लेकिन 100 भाषाओं का समर्थन।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlakši višejezični model. Osnovna preciznost, ali podržava 100 jezika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legkönnyebb többnyelvű modell. Alapszintű pontosság, de 100 nyelvet támogat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modello multilingue più leggero. Precisione di base, ma supporta 100 lingue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も軽量な多言語モデル。基本的な精度だが、100言語対応。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 가벼운 다국어 모델. 기본 정확도이지만 100개 언어를 지원."
          }
        },
        "lt" : {
          "stringUnit" : {
