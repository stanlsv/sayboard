    "Since iOS 26.4, keyboards can no longer identify the app you are typing in, so these settings no longer apply." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "От iOS 26.4 клавиатурите не могат да разпознаят приложението, в което пишете, затова тези настройки вече не се прилагат."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od iOS 26.4 klávesnice nedokážou zjistit, ve které aplikaci píšete, takže se tato nastavení už nepoužívají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra og med iOS 26.4 kan tastaturer ikke se, hvilken app du skriver i, så disse indstillinger bruges ikke længere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit iOS 26.4 können Tastaturen nicht erkennen, in welcher App Sie schreiben, daher werden diese Einstellungen nicht mehr angewendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Από το iOS 26.4 τα πληκτρολόγια δεν μπορούν να αναγνωρίσουν την εφαρμογή στην οποία γράφετε, οπότε αυτές οι ρυθμίσεις δεν ισχύουν πλέον."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde iOS 26.4, los teclados no pueden identificar la app en la que escribe, por lo que estos ajustes ya no se aplican."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alates iOS 26.4-st ei suuda klaviatuurid tuvastada, millises rakenduses te kirjutate, seega neid seadeid enam ei rakendata."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 26.4:stä alkaen näppäimistöt eivät tunnista, missä ohjelmassa kirjoitat, joten näitä asetuksia ei enää käytetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depuis iOS 26.4, les claviers ne peuvent pas identifier l’application dans laquelle vous écrivez, donc ces réglages ne s’appliquent plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 26.4 से कीबोर्ड यह नहीं पहचान सकते कि आप किस ऐप में टाइप कर रहे हैं, इसलिए ये सेटिंग्स अब लागू नहीं होतीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od iOS-a 26.4 tipkovnice ne mogu prepoznati aplikaciju u kojoj pišete, pa se ove postavke više ne primjenjuju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iOS 26.4 óta a billentyűzetek nem tudják felismerni, melyik alkalmazásban ír, ezért ezek a beállítások már nem érvényesek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da iOS 26.4 le tastiere non possono riconoscere l’app in cui sta scrivendo, quindi queste impostazioni non vengono più applicate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 26.4以降、キーボードは入力中のアプリを識別できないため、これらの設定は適用されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 26.4부터 키보드가 입력 중인 앱을 식별할 수 없으므로 이 설정은 더 이상 적용되지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuo iOS 26.4 klaviatūros negali atpažinti, kurioje programėlėje rašote, todėl šie nustatymai nebetaikomi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sākot ar iOS 26.4, tastatūras nevar noteikt, kurā lietotnē Jūs rakstāt, tāpēc šie iestatījumi vairs netiek lietoti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra og med iOS 26.4 kan tastaturer ikke se hvilken app du skriver i, så disse innstillingene brukes ikke lenger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinds iOS 26.4 kunnen toetsenborden niet zien in welke app u typt, dus deze instellingen worden niet meer toegepast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od iOS 26.4 klawiatury nie mogą rozpoznać aplikacji, w której piszesz, więc te ustawienia nie są już stosowane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partir do iOS 26.4, os teclados não conseguem identificar o app em que você está digitando, então essas configurações não são mais aplicadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Începând cu iOS 26.4, tastaturile nu pot identifica aplicația în care scrieți, așa că aceste setări nu se mai aplică."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начиная с iOS 26.4 клавиатуры не могут определить приложение, в котором вы печатаете, поэтому эти настройки больше не применяются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od iOS 26.4 klávesnice nedokážu zistiť, v ktorej aplikácii píšete, takže sa tieto nastavenia už nepoužívajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od iOS 26.4 tipkovnice ne morejo prepoznati aplikacije, v kateri pišete, zato te nastavitve ne veljajo več."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Från och med iOS 26.4 kan tangentbord inte se vilken app du skriver i, så dessa inställningar används inte längre."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 26.4’ten itibaren klavyeler yazdığınız uygulamayı tanıyamıyor, bu nedenle bu ayarlar artık uygulanmıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Починаючи з iOS 26.4 клавіатури не можуть визначити застосунок, у якому ви друкуєте, тому ці налаштування більше не застосовуються."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自 iOS 26.4 起，键盘无法识别您正在输入的应用，因此这些设置不再生效。"
          }
        }
      }
    },
