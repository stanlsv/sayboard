    "Compiled models will be removed from cache. Recompilation will be required on next use, which may take up to a minute.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скомпилированные модели будут удалены из кэша. При следующем использовании потребуется повторная компиляция — это может занять до минуты."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkompilované modely budou odstraněny z mezipaměti. Při příštím použití bude nutná opětovná kompilace, která může trvat až minutu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompilerede modeller fjernes fra cachen. Næste gang du bruger dem, skal de kompileres igen, hvilket kan tage op til et minut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompilierte Modelle werden aus dem Cache entfernt. Bei der nächsten Verwendung ist eine Neukompilierung erforderlich, die bis zu einer Minute dauern kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μεταγλωττισμένα μοντέλα θα αφαιρεθούν από την κρυφή μνήμη. Θα απαιτηθεί εκ νέου μεταγλώττιση κατά την επόμενη χρήση, η οποία μπορεί να διαρκέσει έως ένα λεπτό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos compilados se eliminarán del caché. Habrá que recompilarlos en el próximo uso, lo que puede tardar hasta un minuto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käännetyt mallit poistetaan välimuistista. Seuraavalla käytöllä ne käännetään uudelleen, mikä voi kestää jopa minuutin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles compilés seront supprimés du cache. Une recompilation sera nécessaire à la prochaine utilisation, ce qui peut prendre jusqu’à une minute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संकलित मॉडल कैश से हटा दिए जाएँगे। अगले उपयोग पर पुनः संकलन आवश्यक होगा, जिसमें एक मिनट तक लग सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lefordított modellek törlődnek a gyorsítótárból. A következő használatkor újrafordítás szükséges, ami akár egy percig is tarthat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli compilati verranno rimossi dalla cache. Al prossimo utilizzo sarà necessaria una ricompilazione che potrebbe richiedere fino a un minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパイル済みモデルがキャッシュから削除されます。次回使用時に再コンパイルが必要で、最大1分かかる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴파일된 모델이 캐시에서 제거됩니다. 다음 사용 시 재컴파일이 필요하며, 최대 1분이 소요될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecompileerde modellen worden uit de cache verwijderd. Hercompilatie is nodig bij volgend gebruik, wat tot een minuut kan duren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompilerte modeller fjernes fra bufferen. Ny kompilering kreves ved neste bruk, noe som kan ta opptil ett minutt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skompilowane modele zostaną usunięte z pamięci podręcznej. Przy następnym użyciu wymagana będzie ponowna kompilacja, która może potrwać do minuty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos compilados serão removidos do cache. Será necessária recompilação no próximo uso, o que pode levar até um minuto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelele compilate vor fi eliminate din memoria cache. La următoarea utilizare va fi necesară recompilarea, care poate dura până la un minut."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skompilované modely budú odstránené z vyrovnávacej pamäte. Pri ďalšom použití bude potrebná rekompilácia, ktorá môže trvať až minútu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompilerade modeller tas bort från cachen. Omkompilering krävs vid nästa användning, vilket kan ta upp till en minut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derlenmiş modeller önbellekten kaldırılacaktır. Bir sonraki kullanımda yeniden derleme gerekecek ve bu bir dakikaya kadar sürebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скомпільовані моделі буде видалено з кешу. При наступному використанні знадобиться повторна компіляція, яка може зайняти до хвилини."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已编译的模型将从缓存中移除。下次使用时需要重新编译，可能需要一分钟。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Компилираните модели ще бъдат премахнати от кеша. При следващата употреба ще е необходима повторна компилация, което може да отнеме до минута."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompajlirani modeli bit će uklonjeni iz predmemorije. Pri sljedećem korištenju potrebna je ponovna kompilacija, što može potrajati do jedne minute."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompileeritud mudelid eemaldatakse vahemälust. Järgmisel kasutamisel on vaja need uuesti kompileerida, mis võib võtta kuni minuti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompilētie modeļi tiks izņemti no kešatmiņas. Nākamajā lietošanas reizē būs nepieciešama atkārtota kompilācija, kas var aizņemt līdz minūtei."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukompiliuoti modeliai bus pašalinti iš talpyklos. Kitą kartą naudojant prireiks perkompiliavimo, kuris gali užtrukti iki minutės."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevedeni modeli bodo odstranjeni iz predpomnilnika. Ob naslednji uporabi bo potrebno ponovno prevajanje, kar lahko traja do minute."
          }
        }
      }
    },
