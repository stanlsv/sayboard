    "Swipe right on the indicator below": {
      "comment": "Bottom hint on the host-return overlay, pointing at the iOS home indicator. Tells the user to swipe right on it to switch back to the previous app.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejeďte vpravo po indikátoru níže"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stryg til højre på indikatoren nedenfor"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wischen Sie auf der Anzeige unten nach rechts"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε δεξιά στον δείκτη παρακάτω"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslice a la derecha sobre el indicador de abajo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäise alla olevaa palkkia oikealle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez vers la droite sur l’indicateur ci-dessous"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे दिए गए संकेतक पर दाईं ओर स्वाइप करें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapozzon jobbra az alábbi jelzőn"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorra verso destra sull’indicatore qui sotto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のインジケーターを右にスワイプ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 표시줄에서 오른쪽으로 스와이프"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg naar rechts op de indicator hieronder"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip til høyre på indikatoren nedenfor"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w prawo po wskaźniku poniżej"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para a direita no indicador abaixo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisați la dreapta pe indicatorul de mai jos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайпните вправо по индикатору внизу"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnite vpravo po indikátore nižšie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep åt höger på indikatorn nedan"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki göstergede sağa kaydırın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведіть праворуч по індикатору внизу"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方指示条上向右滑动"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Плъзнете надясно по индикатора долу"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijeđite desno po indikatoru ispod"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pühi all olevat näidikut paremale"
          }
        },
        "lv": {
