    "Create snippets to auto-replace phrases when you dictate. Say the trigger phrase, and the replacement text is inserted instead." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Създайте сниппети за автоматично заместване на фрази при диктовка. Произнесете задействащата фраза и вместо нея ще се вмъкне заместващият текст."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte zkratky pro automatické nahrazení frází při diktování. Řekněte spouštěcí frázi a místo ní se vloží náhradní text."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret uddrag til automatisk erstatning af sætninger, når du dikterer. Sig udløsersætningen, og erstatningsteksten indsættes i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie Textbausteine zum automatischen Ersetzen von Phrasen beim Diktieren. Sagen Sie die Auslösephrase, und der Ersetzungstext wird eingefügt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε αποσπάσματα για αυτόματη αντικατάσταση φράσεων κατά την υπαγόρευση. Πείτε τη φράση ενεργοποίησης και εισάγεται το κείμενο αντικατάστασης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cree fragmentos para sustituir frases automáticamente al dictar. Diga la frase activadora y se insertará el texto de reemplazo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loo lõike, et dikteerimise ajal fraase automaatselt asendada. Ütle päästikfraas ja selle asemel sisestatakse asendustekst."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo pätkiä, jotka korvaavat sanottuja fraaseja automaattisesti. Sano laukaisufraasi, niin korvaava teksti lisätään sen tilalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez des raccourcis pour remplacer automatiquement des phrases pendant la dictée. Dites la phrase déclencheur et le texte de remplacement est inséré à la place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिक्टेशन के दौरान वाक्यांशों को स्वतः बदलने के लिए स्निपेट बनाएँ। ट्रिगर वाक्यांश बोलें, और उसके बदले प्रतिस्थापन टेक्स्ट डाला जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stvorite isječke za automatsku zamjenu fraza tijekom diktiranja. Izgovorite okidačku frazu, a umjesto nje umeće se zamjenski tekst."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hozzon létre szövegrészleteket a kifejezések automatikus cseréjéhez diktáláskor. Mondja ki az indítókifejezést, és helyette a cseresövege kerül beillesztésre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crei degli snippet per sostituire automaticamente le frasi durante la dettatura. Pronunci la frase di attivazione e al suo posto verrà inserito il testo sostitutivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力時にフレーズを自動置換するスニペットを作成します。トリガーフレーズを話すと、代替テキストが挿入されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받아쓰기 시 구문을 자동으로 대체하는 스니펫을 만듭니다. 트리거 문구를 말하면 대체 텍스트가 대신 삽입됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sukurkite fragmentus, kad diktuojant frazės būtų automatiškai pakeičiamos. Pasakykite suaktyvinimo frazę ir vietoj jos bus įterptas pakaitinis tekstas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izveidojiet fragmentus, lai diktēšanas laikā automātiski aizstātu frāzes. Pasakiet aktivizēšanas frāzi, un tās vietā tiks ievietots aizstāšanas teksts."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lag tekstsnutter for å erstatte fraser automatisk når du dikterer. Si utløserfrasen, så settes erstatningsteksten inn i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak fragmenten om zinsdelen automatisch te vervangen tijdens het dicteren. Spreek de triggerzin uit en de vervangende tekst wordt in plaats daarvan ingevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twórz fragmenty do automatycznej zamiany fraz podczas dyktowania. Wypowiedz frazę wyzwalającą, a w jej miejsce zostanie wstawiony tekst zastępczy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie atalhos para substituir frases automaticamente ao ditar. Diga a frase de ativação e o texto de substituição será inserido no lugar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creați fragmente pentru a înlocui automat expresii când dictați. Spuneți expresia de declanșare, iar textul de înlocuire este inserat în locul ei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте сниппеты для автозамены фраз при диктовке. Произнесите триггерную фразу, и вместо неё будет вставлен текст замены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvorte skratky na automatické nahradenie fráz pri diktovaní. Povedzte spúšťaciu frázu a namiesto nej sa vloží náhradný text."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustvarite odlomke za samodejno zamenjavo besednih zvez med narekovanjem. Izgovorite sprožilno besedno zvezo in namesto nje se vstavi nadomestno besedilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapa textutdrag för att ersätta fraser automatiskt när du dikterar. Säg utlösarfrasen, så infogas ersättningstexten i stället."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikte ederken ifadeleri otomatik değiştirmek için kısayollar oluşturun. Tetikleyici ifadeyi söyleyin, yerine değiştirme metni eklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створюйте фрагменти для автозаміни фраз під час диктування. Скажіть тригерну фразу, і замість неї буде вставлено текст заміни."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建文本片段，在听写时自动替换短语。说出触发短语，替换文本将自动插入。"
          }
        }
      }
    },
