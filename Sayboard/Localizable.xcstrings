    "Network error. Check your connection and try again.": {
      "comment": "Error when model download fails due to a network issue",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка сети. Проверьте подключение и попробуйте снова."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chyba sítě. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Netværksfejl. Kontrollér din forbindelse og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerkfehler. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σφάλμα δικτύου. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de red. Compruebe su conexión y vuelva a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkovirhe. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur réseau. Vérifiez votre connexion et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क त्रुटि। अपना कनेक्शन जाँचें और पुनः प्रयास करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hálózati hiba. Ellenőrizze a kapcsolatát, és próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Errore di rete. Controlli la connessione e riprovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークエラー。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 오류입니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Netwerkfout. Controleer uw verbinding en probeer het opnieuw."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettverksfeil. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Błąd sieci. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro de rede. Verifique sua conexão e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eroare de rețea. Verificați conexiunea și încercați din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chyba siete. Skontrolujte pripojenie a skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nätverksfel. Kontrollera din anslutning och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ hatası. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помилка мережі. Перевірте зʼєднання та спробуйте знову."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "网络错误。请检查网络连接后重试。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мрежова грешка. Проверете връзката си и опитайте отново."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mrežna pogreška. Provjerite vezu i pokušajte ponovno."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võrgu viga. Kontrollige ühendust ja proovige uuesti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tīkla kļūda. Pārbaudiet savienojumu un mēģiniet vēlreiz."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinklo klaida. Patikrinkite ryšį ir bandykite dar kartą."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napaka omrežja. Preverite povezavo in poskusite znova."
          }
        }
      }
