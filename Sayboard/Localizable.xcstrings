        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zařízení nemá e-mailovou aplikaci, kterou by šlo otevřít, takže adresa je místo toho ve schránce. Vložte %@ tam, kde čtete svou poštu."
