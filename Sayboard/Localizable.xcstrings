    "Choose how dictated text is formatted. You can change this anytime in Settings." : {
      "comment" : "Onboarding",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете как да се форматира диктуваният текст. Можете да промените това по всяко време в Настройки."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, jak se má nadiktovaný text formátovat. Kdykoli to můžete změnit v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvordan dikteret tekst skal formateres. Du kan altid ændre det i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie, wie diktierter Text formatiert wird. Sie können das jederzeit in den Einstellungen ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε πώς θα μορφοποιείται το κείμενο που υπαγορεύετε. Μπορείτε να το αλλάξετε οποιαδήποτε στιγμή στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija el formato del texto dictado. Puede cambiarlo cuando quiera en Ajustes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valige, kuidas dikteeritud tekst vormindatakse. Saate seda igal ajal Seadetes muuta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, miten sanelemasi teksti muotoillaan. Voit muuttaa tätä milloin tahansa Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la mise en forme du texte dicté. Vous pourrez modifier ce choix à tout moment dans Réglages."
          }
        },
        "hi" : {
