    "Actions that appear when you tap the AI button on the keyboard.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действия, которые появляются при нажатии кнопки ИИ на клавиатуре."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Akce, které se zobrazí po klepnutí na tlačítko AI na klávesnici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlinger der vises, når du trykker på AI-knappen på tastaturet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktionen, die erscheinen, wenn Sie die AI-Taste auf der Tastatur drücken."
