        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tādējādi tiks atbrīvota krātuve. Jūs to varat lejupielādēt atkārtoti jebkurā laikā."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai atlaisvins vietos atmintyje. Bet kada galėsite atsisiųsti iš naujo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To bo sprostilo prostor. Ponovno ga lahko prenesete kadar koli."
          }
        }
      }
    },
