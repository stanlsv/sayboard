    "Best overall quality and the widest language coverage. Slower than the 1B models.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучшее общее качество и самый широкий охват языков. Медленнее моделей на 1B."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
