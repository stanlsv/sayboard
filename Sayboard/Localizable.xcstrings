          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Показвай бутона за смяна на клавиатурата"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži tipku za promjenu tipkovnice"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva klaviatuuri vahetamise klahv"
