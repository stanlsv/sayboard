            "value": "İndirme kesildi. Devam etmek için Tekrar Dene'ye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаження було перервано. Натисніть «Повторити», щоб продовжити."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "下载已中断。点击「重试」继续。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтеглянето беше прекъснато. Натиснете „Опитай отново“, за да продължите."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzimanje je prekinuto. Dodirnite Pokušaj ponovno za nastavak."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Allalaadimine katkestati. Jätkamiseks puudutage Proovi uuesti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejupielāde tika pārtraukta. Pieskarieties Mēģināt vēlreiz, lai turpinātu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsisiuntimas buvo nutrauktas. Palieskite „Bandyti dar kartą“, kad tęstumėte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenos je bil prekinjen. Za nadaljevanje se dotaknite Poskusi znova."
          }
        }
      }
    },
