    "Long-pressing the AI button on keyboard runs this action directly, skipping the action list.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Долгое нажатие на кнопку ИИ на клавиатуре сразу запускает это действие, минуя список."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlouhým stisknutím tlačítka AI na klávesnici se tato akce spustí přímo, bez zobrazení seznamu akcí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et langt tryk på AI-knappen på tastaturet kører denne handling direkte og springer handlingslisten over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langes Drücken der AI-Taste auf der Tastatur führt diese Aktion direkt aus, ohne die Aktionsliste anzuzeigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με παρατεταμένο πάτημα του κουμπιού AI στο πληκτρολόγιο εκτελείται αυτή η ενέργεια απευθείας, παρακάμπτοντας τη λίστα ενεργειών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al mantener pulsado el botón de IA en el teclado se ejecuta esta acción directamente, sin pasar por la lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun painat AI-painiketta pitkään, tämä toiminto suoritetaan suoraan ilman toimintoluetteloa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appui long sur le bouton IA du clavier exécute cette action directement, sans passer par la liste d'actions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीबोर्ड पर AI बटन को देर तक दबाने से यह क्रिया सीधे चलती है, क्रिया सूची को छोड़कर।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AI gomb hosszú lenyomása a billentyűzeten közvetlenül futtatja ezt a műveletet, a műveletlista kihagyásával."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenendo premuto il pulsante IA sulla tastiera viene eseguita direttamente questa azione, saltando l'elenco delle azioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードのAIボタンを長押しすると、アクションリストをスキップしてこのアクションが直接実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드의 AI 버튼을 길게 누르면 작업 목록을 건너뛰고 이 작업이 바로 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lang indrukken van de AI-knop op het toetsenbord voert deze actie direct uit, zonder de actielijst te tonen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Å holde inne AI-knappen på tastaturet kjører denne handlingen direkte, uten å vise handlingslisten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Długie naciśnięcie przycisku AI na klawiaturze uruchamia tę akcję bezpośrednio, pomijając listę akcji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressionar e segurar o botão de IA no teclado executa esta ação diretamente, sem mostrar a lista de ações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsarea lungă a butonului AI de pe tastatură execută această acțiune direct, sărind peste lista de acțiuni."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlhé stlačenie tlačidla AI na klávesnici spustí túto akciu priamo, bez zobrazenia zoznamu akcií."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Långt tryck på AI-knappen på tangentbordet kör denna åtgärd direkt, utan att visa åtgärdslistan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyedeki AI düğmesine uzun basıldığında, işlem listesi atlanarak bu işlem doğrudan çalıştırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Довге натискання кнопки ШІ на клавіатурі запускає цю дію напряму, оминаючи список дій."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "长按键盘上的 AI 按钮可直接运行此操作，跳过操作列表。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дългото натискане на AI бутона на клавиатурата изпълнява това действие директно, прескачайки списъка с действия."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dugim pritiskom na AI gumb na tipkovnici ova se akcija pokreće izravno, bez prikaza popisa akcija."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuuri AI nupu pikalt vajutamine käivitab selle tegevuse otse, jättes tegevuste loendi vahele."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilgi nospiežot AI pogu uz tastatūras, šī darbība tiek izpildīta tieši, izlaižot darbību sarakstu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilgai paspaudus AI mygtuką klaviatūroje, šis veiksmas paleidžiamas tiesiogiai, praleidžiant veiksmų sąrašą."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolg pritisk gumba AI na tipkovnici neposredno zažene to dejanje in preskoči seznam dejanj."
          }
        }
      }
    },
