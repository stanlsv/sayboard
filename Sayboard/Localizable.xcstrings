    "This action will run automatically after every dictated text.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это действие будет запускаться автоматически после каждой диктовки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato akce se spustí automaticky po každém nadiktovaném textu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne handling køres automatisk efter hver dikteret tekst."
          }
        },
        "de": {
          "stringUnit": {
