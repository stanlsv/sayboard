    "Model failed to load. Tap Retry to try again.": {
      "comment": "Error message displayed when a model fails to load after downloading.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model failed to load. Tap Retry to try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить модель. Нажмите «Повторить», чтобы попробовать снова."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model se nepodařilo načíst. Klepněte na Zkusit znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Model kunne ikke indlæses. Tryk på Prøv igen for at prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell konnte nicht geladen werden. Tippen Sie auf „Erneut versuchen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο απέτυχε να φορτωθεί. Πατήστε Επανάληψη για να δοκιμάσετε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el modelo. Toque Reintentar para volver a probar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mallin lataus epäonnistui. Napauta Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du chargement du modèle. Touchez « Réessayer »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल लोड होने में विफल। पुनः प्रयास के लिए Retry पर टैप करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A modell betöltése nem sikerült. Koppintson az Újrapróbálás gombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caricamento del modello non riuscito. Tocchi “Riprova” per ritentare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの読み込みに失敗しました。再試行をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 로드에 실패했습니다. 다시 시도하려면 재시도를 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model laden mislukt. Tik op Opnieuw om het nog eens te proberen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen kunne ikke lastes. Trykk Prøv igjen for å forsøke på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się załadować modelu. Stuknij Ponów, aby spróbować ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao carregar o modelo. Toque em Tentar Novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelul nu a putut fi încărcat. Atingeți Reîncearcă pentru a încerca din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Model sa nepodarilo načítať. Ťuknite na Skúsiť znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen kunde inte laddas. Tryck på Försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model yüklenemedi. Tekrar denemek için Tekrar Dene'ye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити модель. Натисніть «Повторити», щоб спробувати знову."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "模型加载失败。点击「重试」再试一次。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделът не успя да се зареди. Натиснете „Опитай отново“, за да опитате пак."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Učitavanje modela nije uspjelo. Dodirnite Pokušaj ponovno."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudeli laadimine nurjus. Puudutage Proovi uuesti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeli neizdevās ielādēt. Pieskarieties Mēģināt vēlreiz."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko įkelti modelio. Palieskite „Bandyti dar kartą“."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modela ni bilo mogoče naložiti. Za ponovni poskus se dotaknite Poskusi znova."
          }
        }
      }
