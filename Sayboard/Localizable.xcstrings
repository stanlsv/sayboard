    "Microphone access is needed for speech recognition.\n\nAll processing stays on your device.": {
      "comment": "A description of why microphone access is needed for speech recognition, including that all processing happens on the user's device.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к микрофону необходим для распознавания речи.\n\nВся обработка происходит на вашем устройстве."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro rozpoznávání řeči je potřeba přístup k mikrofonu.\n\nVeškeré zpracování zůstává na vašem zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonadgang er nødvendig til talegenkendelse.\n\nAl behandling forbliver på din enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Spracherkennung wird Mikrofonzugriff benötigt.\n\nDie gesamte Verarbeitung bleibt auf Ihrem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτείται πρόσβαση στο μικρόφωνο για την αναγνώριση ομιλίας.\n\nΌλη η επεξεργασία παραμένει στη συσκευή σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso al micrófono para el reconocimiento de voz.\n\nTodo el procesamiento permanece en su dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puheentunnistus tarvitsee mikrofonin käyttöoikeuden.\n\nKaikki käsittely pysyy laitteessasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au microphone est nécessaire pour la reconnaissance vocale.\n\nTout le traitement reste sur votre appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पीच रिकग्निशन के लिए माइक्रोफ़ोन एक्सेस आवश्यक है।\n\nसारी प्रोसेसिंग आपके डिवाइस पर ही रहती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszédfelismeréshez mikrofon-hozzáférés szükséges.\n\nMinden feldolgozás az eszközön marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al microfono è necessario per il riconoscimento vocale.\n\nTutta l'elaborazione resta sul Suo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声認識にはマイクへのアクセスが必要です。\n\nすべての処理はデバイス上で行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 인식을 위해 마이크 접근이 필요합니다.\n\n모든 처리는 기기에서 이루어집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfoontoegang is nodig voor spraakherkenning.\n\nAlle verwerking blijft op uw apparaat."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofontilgang er nødvendig for talegjenkjenning.\n\nAll behandling forblir på enheten din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do mikrofonu jest potrzebny do rozpoznawania mowy.\n\nCałe przetwarzanie pozostaje na urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone é necessário para o reconhecimento de voz.\n\nTodo o processamento permanece no seu dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la microfon este necesar pentru recunoașterea vocală.\n\nToată procesarea rămâne pe dispozitivul dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre rozpoznávanie reči je potrebný prístup k mikrofónu.\n\nVšetko spracovanie zostáva na vašom zariadení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonåtkomst behövs för taligenkänning.\n\nAll bearbetning stannar på din enhet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma tanıma için mikrofon erişimi gereklidir.\n\nTüm işlem cihazınızda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для розпізнавання мовлення потрібен доступ до мікрофона.\n\nУся обробка залишається на вашому пристрої."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "语音识别需要麦克风权限。\n\n所有处理均在您的设备上完成。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Достъпът до микрофона е необходим за разпознаване на реч.\n\nЦялата обработка остава на Вашето устройство."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup mikrofonu potreban je za prepoznavanje govora.\n\nCijela obrada ostaje na vašem uređaju."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõnetuvastuseks on vaja juurdepääsu mikrofonile.\n\nKogu töötlus jääb teie seadmesse."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Runas atpazīšanai ir nepieciešama piekļuve mikrofonam.\n\nVisa apstrāde paliek Jūsu ierīcē."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofono prieiga reikalinga kalbos atpažinimui.\n\nVisas apdorojimas lieka Jūsų įrenginyje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za prepoznavanje govora je potreben dostop do mikrofona.\n\nVsa obdelava ostane v Vaši napravi."
          }
        }
      }
    },
