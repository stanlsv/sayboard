    "Sayboard will prioritize these languages. Pick a single language for the most accurate recognition.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard будет отдавать приоритет этим языкам. Выберите один язык для самого точного распознавания."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
