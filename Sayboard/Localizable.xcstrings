    "Small English model. Better than Moonshine Tiny, no streaming.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Небольшая модель для английского. Точнее Moonshine Tiny, без потока."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Malý anglický model. Lepší než Moonshine Tiny, bez streamování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lille engelsk model. Bedre end Moonshine Tiny, ingen streaming."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleines englisches Modell. Besser als Moonshine Tiny, kein Streaming."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μικρό αγγλικό μοντέλο. Καλύτερο από το Moonshine Tiny, χωρίς ροή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo pequeño en inglés. Mejor que Moonshine Tiny, sin streaming."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieni englanninkielinen malli. Parempi kuin Moonshine Tiny, ei suoratoistoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit modèle anglais. Meilleur que Moonshine Tiny, pas de streaming."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटा अंग्रेज़ी मॉडल। Moonshine Tiny से बेहतर, कोई स्ट्रीमिंग नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kis angol modell. Jobb, mint a Moonshine Tiny, nincs streaming."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modello inglese di piccole dimensioni. Migliore di Moonshine Tiny, senza streaming."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小型英語モデル。Moonshine Tinyより高性能、ストリーミングなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 영어 모델. Moonshine Tiny보다 우수, 스트리밍 없음."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein Engels model. Beter dan Moonshine Tiny, geen streaming."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Liten engelsk modell. Bedre enn Moonshine Tiny, ingen strømming."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mały model angielski. Lepszy niż Moonshine Tiny, bez strumieniowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo pequeno em inglês. Melhor que o Moonshine Tiny, sem streaming."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Model mic în engleză. Mai bun decât Moonshine Tiny, fără streaming."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Malý anglický model. Lepší ako Moonshine Tiny, bez streamovania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liten engelsk modell. Bättre än Moonshine Tiny, ingen streaming."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük İngilizce model. Moonshine Tiny’den daha iyi, akış yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невелика англійська модель. Краща за Moonshine Tiny, без потокового передавання."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "小型英语模型。比 Moonshine Tiny 更好，无流式处理。"
