          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uuendage Sayboardi, et seda mudelit kasutada."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atjauniniet Sayboard, lai izmantotu šo modeli."
          }
        },
        "lt": {
