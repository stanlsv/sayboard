          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard bu dillere öncelik verir. En doğru tanıma için tek bir dil seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard надасть пріоритет цим мовам. Виберіть одну мову для найточнішого розпізнавання."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard 将优先识别这些语言。选择单一语言可获得最准确的识别效果。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard ще даде приоритет на тези езици. Изберете един език за най-точно разпознаване."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard će dati prednost ovim jezicima. Odaberite samo jedan jezik za najtočnije prepoznavanje."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard eelistab neid keeli. Kõige täpsema tuvastuse jaoks valige üks keel."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard prioritizēs šīs valodas. Izvēlieties vienu valodu, lai iegūtu visprecīzāko atpazīšanu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayboard pirmenybę teiks šioms kalboms. Tiksliausiam atpažinimui pasirinkite vieną kalbą."
