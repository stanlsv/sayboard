    "Full Access is disabled. Open the Sayboard app for setup instructions": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plný přístup je vypnutý. Otevřete aplikaci Sayboard pro pokyny k nastavení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuld adgang er deaktiveret. Åbn Sayboard-appen for opsætningsinstruktioner"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollzugriff ist deaktiviert. Öffnen Sie die Sayboard-App zur Einrichtung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πλήρης πρόσβαση είναι απενεργοποιημένη. Ανοίξτε την εφαρμογή Sayboard για οδηγίες ρύθμισης"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso completo está desactivado. Abra la app Sayboard para ver las instrucciones de configuración"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täysi käyttöoikeus on pois käytöstä. Avaa Sayboard-ohjelma ja katso käyttöönotto-ohjeet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès complet désactivé. Ouvrez l'application Sayboard pour la configuration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण एक्सेस अक्षम है। सेटअप निर्देशों के लिए Sayboard ऐप खोलें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes hozzáférés ki van kapcsolva. A beállítási útmutatóért nyissa meg a Sayboard alkalmazást"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso completo disattivato. Apra l'app Sayboard per le istruzioni di configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルアクセスが無効です。設定手順についてはSayboardアプリを開いてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 접근이 비활성화되어 있습니다. 설정 안내를 보려면 Sayboard 앱을 여세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledige toegang is uitgeschakeld. Open de Sayboard-app voor installatie-instructies"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Full tilgang er deaktivert. Åpne Sayboard-appen for oppsettsanvisninger"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełny dostęp jest wyłączony. Otwórz aplikację Sayboard, aby uzyskać instrukcje konfiguracji"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso completo está desativado. Abra o app Sayboard para ver as instruções de configuração"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul complet este dezactivat. Deschideți aplicația Sayboard pentru instrucțiuni de configurare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный доступ отключён. Откройте приложение Sayboard для инструкций по настройке"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plný prístup je vypnutý. Otvorte aplikáciu Sayboard pre pokyny na nastavenie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fullständig åtkomst är inaktiverad. Öppna Sayboard-appen för konfigurationsanvisningar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam Erişim devre dışı. Kurulum talimatları için Sayboard uygulamasını açın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повний доступ вимкнено. Відкрийте застосунок Sayboard для інструкцій з налаштування"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "完全访问已禁用。请打开 Sayboard 应用查看设置说明"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пълният достъп е изключен. Отворете приложението Sayboard за инструкции по настройка"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potpuni pristup je isključen. Otvorite aplikaciju Sayboard za upute za postavljanje"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täielik juurdepääs on välja lülitatud. Seadistusjuhiste saamiseks avage rakendus Sayboard"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilna piekļuve ir izslēgta. Atveriet Sayboard lietotni iestatīšanas instrukcijām"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visapusiška prieiga išjungta. Atidarykite Sayboard programėlę, kad gautumėte sąrankos instrukcijas"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polni dostop je onemogočen. Odprite aplikacijo Sayboard za navodila za nastavitev"
          }
        }
      }
