    "Low storage causes constant model rebuilds": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Málo úložiště způsobuje neustálé přestavby modelu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lav lagerplads får modellen til at blive bygget om hele tiden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei wenig Speicher wird das Modell ständig neu kompiliert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο χαμηλός αποθηκευτικός χώρος προκαλεί συνεχείς αναδημιουργίες μοντέλου"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El poco almacenamiento causa reconstrucciones constantes del modelo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vähäinen tallennustila aiheuttaa mallin jatkuvaa uudelleenrakentamista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un stockage faible entraîne des reconstructions constantes du modèle"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम स्टोरेज के कारण मॉडल बार-बार रीबिल्ड होता है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kevés tárhely folyamatos modell-újraépítést okoz"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio insufficiente causa continue ricostruzioni del modello"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージ不足によりモデルの再構築が繰り返されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간 부족으로 모델이 계속 재구축됩니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weinig opslagruimte veroorzaakt voortdurend opnieuw opbouwen van het model"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Lite lagringsplass fører til stadig gjenoppbygging av modellen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mało miejsca powoduje ciągłą odbudowę modelu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouco armazenamento causa reconstruções constantes do modelo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spațiul de stocare redus cauzează reconstruirea constantă a modelului"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало места. Модель пересобирается каждый раз"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Málo úložiska spôsobuje neustále prestavby modelu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Litet lagringsutrymme orsakar ständiga ombyggnader av modellen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük depolama alanı sürekli model yeniden derlemesine neden olur"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало місця. Модель перезбирається щоразу"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "存储空间不足导致模型不断重建"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Малко място. Моделът се преизгражда всеки път"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedostatak prostora uzrokuje stalnu ponovnu izgradnju modela"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vähene mäluruum põhjustab pidevat mudeli uuesti ehitamist"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Maz krātuves izraisa pastāvīgu modeļa atjaunošanu"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mažai vietos atmintyje — modelis nuolat perkuriamas"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Premalo prostora povzroča nenehno ponovno gradnjo modela"
          }
        }
      }
    },
    "Microphone is disabled. Allow Sayboard microphone access to recognize your speech": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon je vypnutý. Povolte Sayboardu přístup k mikrofonu pro rozpoznávání řeči"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen er deaktiveret. Tillad Sayboard mikrofonadgang for at genkende din tale"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon ist deaktiviert. Erlauben Sie den Mikrofonzugriff für Sayboard, um Ihre Sprache zu erkennen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μικρόφωνο είναι απενεργοποιημένο. Επιτρέψτε στο Sayboard πρόσβαση στο μικρόφωνο για να αναγνωρίζει την ομιλία σας"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono está desactivado. Permita a Sayboard acceder al micrófono para reconocer su voz"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoni on pois käytöstä. Salli Sayboardille mikrofonin käyttö, jotta puhe voidaan tunnistaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone est désactivé. Autorisez l'accès au microphone pour Sayboard afin de reconnaître votre voix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन अक्षम है। आपकी आवाज़ पहचानने के लिए Sayboard को माइक्रोफ़ोन एक्सेस दें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofon ki van kapcsolva. A beszédfelismeréshez engedélyezze a Sayboard mikrofon-hozzáférését"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfono disattivato. Conceda a Sayboard l'accesso al microfono per riconoscere il Suo parlato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクが無効です。音声を認識するためにSayboardのマイクアクセスを許可してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 비활성화되어 있습니다. 음성을 인식하려면 Sayboard에 마이크 접근을 허용하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfoon is uitgeschakeld. Geef Sayboard microfoontoegang om uw spraak te herkennen"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen er deaktivert. Gi Sayboard mikrofontilgang for å gjenkjenne talen din"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon jest wyłączony. Zezwól Sayboardowi na dostęp do mikrofonu, aby rozpoznawał mowę"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone está desativado. Permita o acesso ao microfone do Sayboard para reconhecer sua fala"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfonul este dezactivat. Permiteți Sayboard accesul la microfon pentru a vă recunoaște vocea"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон отключён. Разрешите Sayboard доступ к микрофону для распознавания речи"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofón je vypnutý. Povoľte Sayboardu prístup k mikrofónu na rozpoznávanie reči"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen är inaktiverad. Ge Sayboard mikrofonåtkomst för att känna igen ditt tal"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon devre dışı. Konuşmanızı tanıyabilmek için Sayboard'a mikrofon erişimi verin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон вимкнено. Дозвольте Sayboard доступ до мікрофона для розпізнавання мовлення"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风已禁用。请允许 Sayboard 使用麦克风以识别您的语音"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофонът е изключен. Разрешете на Sayboard достъп до микрофона, за да разпознава речта Ви"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon je isključen. Dopustite Sayboardu pristup mikrofonu za prepoznavanje vašeg govora"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon on välja lülitatud. Kõne tuvastamiseks lubage Sayboardile juurdepääs mikrofonile"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofons ir izslēgts. Atļaujiet Sayboard piekļuvi mikrofonam, lai atpazītu Jūsu runu"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonas išjungtas. Leiskite Sayboard prieigą prie mikrofono, kad atpažintų Jūsų kalbą"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon je onemogočen. Dovolite Sayboardu dostop do mikrofona za prepoznavanje govora"
          }
        }
      }
    },
    "To use AI actions, make sure the text field has text and the cursor is after it": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro použití akcí AI se ujistěte, že textové pole obsahuje text a kurzor je za ním"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at bruge AI-handlinger skal tekstfeltet have tekst, og markøren skal stå efter den"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um KI-Aktionen zu verwenden, achten Sie darauf, dass das Textfeld Text enthält und der Cursor dahinter steht"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να χρησιμοποιήσετε ενέργειες AI, βεβαιωθείτε ότι το πεδίο κειμένου έχει κείμενο και ο κέρσορας βρίσκεται μετά από αυτό"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar acciones de IA, asegúrese de que el campo de texto tenga texto y el cursor esté después"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos haluat käyttää AI-toimintoja, varmista, että tekstikentässä on tekstiä ja kohdistin on sen jälkeen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser les actions IA, assurez-vous que le champ de texte contient du texte et que le curseur se trouve juste après."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI क्रियाओं का उपयोग करने के लिए, सुनिश्चित करें कि टेक्स्ट फ़ील्ड में टेक्स्ट है और कर्सर उसके बाद है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AI-műveletek használatához győződjön meg arról, hogy a szövegmezőben van szöveg, és a kurzor utána áll"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per usare le azioni IA, si assicuri che il campo di testo contenga del testo e che il cursore sia posizionato dopo di esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIアクションを使用するには、テキストフィールドにテキストがあり、カーソルがその後にあることを確認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 작업을 사용하려면 텍스트 필드에 텍스트가 있고 커서가 그 뒤에 있는지 확인하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om AI-acties te gebruiken, zorg dat het tekstveld tekst bevat en de cursor erachter staat"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "For å bruke AI-handlinger må tekstfeltet ha tekst og markøren stå etter den"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby użyć akcji AI, upewnij się, że pole tekstowe zawiera tekst, a kursor znajduje się za nim"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar as ações de IA, confira se o campo de texto tem texto e se o cursor está depois dele"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a folosi acțiunile AI, asigurați-vă că în câmpul de text există text și cursorul este după acesta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для действий ИИ убедитесь, что в поле есть текст и курсор стоит после него"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete použiť akcie AI, uistite sa, že textové pole obsahuje text a kurzor je za ním"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att använda AI-åtgärder, se till att textfältet har text och att markören är efter den"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI işlemlerini kullanmak için metin alanında metin olduğundan ve imlecin metnin sonunda olduğundan emin olun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб скористатися діями ШІ, переконайтеся, що в текстовому полі є текст і курсор стоїть після нього"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "要使用 AI 操作，请确保文本框中有文字且光标在文字之后"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да използвате AI действията, уверете се, че текстовото поле съдържа текст и курсорът е след него"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Da biste koristili AI akcije, provjerite da tekstualno polje sadrži tekst i da je pokazivač iza njega"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "AI tegevuste kasutamiseks veenduge, et tekstiväljas on tekst ja kursor on selle järel"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai izmantotu AI darbības, pārliecinieties, ka teksta laukā ir teksts un kursors ir aiz tā"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norėdami naudoti AI veiksmus, įsitikinkite, kad teksto lauke yra teksto, o žymeklis yra po juo"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za uporabo dejanj AI se prepričajte, da je v besedilnem polju besedilo in da je kazalec za njim"
          }
        }
      }
    },
    "No speech model yet. Download a speech model to start using voice input": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný model řeči. Stáhněte model řeči, abyste mohli začít používat hlasový vstup"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen talemodel endnu. Download en talemodel for at begynde at bruge stemmeinput"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Sprachmodell vorhanden. Laden Sie ein Sprachmodell herunter, um die Spracheingabe zu nutzen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει μοντέλο ομιλίας ακόμα. Κατεβάστε ένα μοντέλο ομιλίας για να αρχίσετε να χρησιμοποιείτε φωνητική εισαγωγή"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay modelo de voz. Descargue un modelo para empezar a usar la entrada por voz"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei puhemallia vielä. Lataa puhemalli, niin voit alkaa kirjoittaa puheella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun modèle vocal. Téléchargez un modèle vocal pour commencer la saisie vocale"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई स्पीच मॉडल नहीं है। वॉइस इनपुट शुरू करने के लिए स्पीच मॉडल डाउनलोड करें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs beszédmodell. A hangbevitel használatához töltsön le egy beszédmodellt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun modello vocale ancora. Scarichi un modello vocale per iniziare a usare l'input vocale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声モデルがありません。音声入力を使うには音声モデルをダウンロードしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 모델이 없습니다. 음성 입력을 시작하려면 음성 모델을 다운로드하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen spraakmodel. Download een spraakmodel om spraakinvoer te gebruiken"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen talemodell ennå. Last ned en talemodell for å begynne å bruke taleinndata"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak modelu mowy. Pobierz model mowy, aby rozpocząć korzystanie z wprowadzania głosowego"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum modelo de fala ainda. Baixe um modelo de fala para começar a usar a entrada por voz"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun model vocal încă. Descărcați un model vocal pentru a începe să folosiți introducerea vocală"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель речи не загружена. Скачайте модель, чтобы начать голосовой ввод"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ žiadny model reči. Stiahnite si model reči, aby ste mohli začať používať hlasový vstup"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen talmodell ännu. Ladda ner en talmodell för att börja använda röstinmatning"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz konuşma modeli yok. Sesli girişi kullanmaya başlamak için bir konuşma modeli indirin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель мовлення ще не завантажено. Завантажте модель, щоб почати голосове введення"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无语音模型。请下载语音模型以开始使用语音输入"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още няма модел за реч. Изтеглете модел за реч, за да започнете гласово въвеждане"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema modela govora. Preuzmite model govora kako biste počeli koristiti glasovni unos"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõnemudelit veel pole. Häälsisestuse alustamiseks laadige alla kõnemudel"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēl nav runas modeļa. Lejupielādējiet runas modeli, lai sāktu izmantot balss ievadi"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalbos modelio dar nėra. Atsisiųskite kalbos modelį, kad pradėtumėte naudoti balso įvestį"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še ni modela govora. Prenesite model govora, da začnete uporabljati glasovni vnos"
          }
        }
      }
    },
